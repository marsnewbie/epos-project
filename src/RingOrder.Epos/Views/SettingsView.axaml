<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RingOrder.Epos.ViewModels"
             xmlns:conv="using:RingOrder.Epos.Converters"
             xmlns:domain="using:RingOrder.Epos.Domain"
             x:Class="RingOrder.Epos.Views.SettingsView"
             x:Name="Root"
             x:DataType="vm:SettingsViewModel"
             Background="{StaticResource Page}">
  <Grid ColumnDefinitions="168,*" Margin="4">
    <Border Classes="panel" CornerRadius="8" Padding="8" Margin="0,0,8,0">
      <StackPanel>
        <Button Classes="btn" Classes.on="{Binding IsShop}" Content="{Binding LblSecShop}" Command="{Binding GoSectionCommand}" CommandParameter="Shop" />
        <Button Classes="btn" Classes.on="{Binding IsMenu}" Content="{Binding LblSecMenu}" Command="{Binding GoSectionCommand}" CommandParameter="Menu" />
        <Button Classes="btn" Classes.on="{Binding IsNotes}" Content="{Binding LblSecNotes}" Command="{Binding GoSectionCommand}" CommandParameter="Notes" />
        <Button Classes="btn" Classes.on="{Binding IsDelivery}" Content="{Binding LblSecDelivery}" Command="{Binding GoSectionCommand}" CommandParameter="Delivery" />
        <Button Classes="btn" Classes.on="{Binding IsHardware}" Content="{Binding LblSecHardware}" Command="{Binding GoSectionCommand}" CommandParameter="Hardware" />
        <Button Classes="btn" Classes.on="{Binding IsStaff}" Content="{Binding LblSecStaff}" Command="{Binding GoSectionCommand}" CommandParameter="Staff" />
        <Button Classes="btn" Classes.on="{Binding IsShift}" Content="{Binding LblSecShift}" Command="{Binding GoSectionCommand}" CommandParameter="Shift" />
        <Button Classes="btn" Classes.on="{Binding IsOnline}" Content="{Binding LblSecOnline}" Command="{Binding GoSectionCommand}" CommandParameter="Online" Margin="0,12,0,0" />
        <Button Classes="btn" Classes.on="{Binding IsTax}" Content="VAT" Command="{Binding GoSectionCommand}" CommandParameter="Tax" />
        <Button Classes="btn" Classes.on="{Binding IsPrivacy}" Content="Customer data" Command="{Binding GoSectionCommand}" CommandParameter="Privacy" />
        <Button Classes="btn" Classes.on="{Binding IsCloud}" Content="Cloud" Command="{Binding GoSectionCommand}" CommandParameter="Cloud" />
        <Button Classes="btn" Classes.on="{Binding IsSupport}" Content="Support" Command="{Binding GoSectionCommand}" CommandParameter="Support" />
        <Button Classes="cash" Content="{Binding LblSave}" Command="{Binding SaveCommand}" Height="52" Margin="0,16,0,0" />
        <TextBlock Text="{Binding LblUiLangNote}" Classes="muted" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Column="1">
      <Panel>
      <StackPanel MaxWidth="820" IsVisible="{Binding !IsMenu}">

        <Border Classes="panel" CornerRadius="8" Padding="16" IsVisible="{Binding IsShop}">
          <StackPanel Spacing="4">
            <TextBlock Text="Shop / 店铺" FontWeight="Bold" FontSize="18" Foreground="#1c1917" Margin="0,0,0,8" />
            <TextBox Classes="field" Watermark="Shop name" Text="{Binding ShopName}" />
            <TextBox Classes="field" Watermark="Address" Text="{Binding ShopAddress}" />
            <TextBox Classes="field" Watermark="Postcode" Text="{Binding ShopPostcode}" />
            <TextBox Classes="field" Watermark="Phone" Text="{Binding ShopPhone}" />
          </StackPanel>
        </Border>

        <Border Classes="panel" CornerRadius="8" Padding="16" IsVisible="{Binding IsDelivery}">
          <StackPanel Spacing="4">
            <TextBlock Text="Delivery / 外卖费" FontWeight="Bold" FontSize="18" Foreground="#1c1917" Margin="0,0,0,8" />
            <TextBox Classes="field" Watermark="Default delivery fee £" Text="{Binding DefaultDeliveryFeeText}" />

            <TextBlock Text="Zones" Classes="title" Margin="0,20,0,0" />
            <TextBlock Text="{Binding ZoneHint}" Classes="muted" TextWrapping="Wrap" />

            <Grid ColumnDefinitions="90,*,80,80,80,70,40" Margin="0,8,0,2">
              <TextBlock Text="Prefix" Classes="muted" FontSize="11" />
              <TextBlock Grid.Column="1" Text="Area name" Classes="muted" FontSize="11" />
              <TextBlock Grid.Column="2" Text="Fee £" Classes="muted" FontSize="11" />
              <TextBlock Grid.Column="3" Text="Min £" Classes="muted" FontSize="11" />
              <TextBlock Grid.Column="4" Text="Free £" Classes="muted" FontSize="11" />
              <TextBlock Grid.Column="5" Text="On" Classes="muted" FontSize="11" />
            </Grid>

            <ItemsControl ItemsSource="{Binding DeliveryZones}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DeliveryZoneRow">
                  <Grid ColumnDefinitions="90,*,80,80,80,70,40" Margin="0,0,0,6">
                    <TextBox Classes="field" Text="{Binding Prefix}" Margin="0,0,6,0" />
                    <TextBox Grid.Column="1" Classes="field" Text="{Binding Name}" Margin="0,0,6,0"
                             Watermark="e.g. Kingstanding" />
                    <NumericUpDown Grid.Column="2" Value="{Binding Fee}" Minimum="0" Maximum="99"
                                   Increment="0.5" FormatString="0.00" Height="44" Margin="0,0,4,0"
                                   ShowButtonSpinner="False" />
                    <NumericUpDown Grid.Column="3" Value="{Binding MinimumOrder}" Minimum="0" Maximum="999"
                                   Increment="1" FormatString="0.00" Height="44" Margin="0,0,4,0"
                                   ShowButtonSpinner="False" />
                    <NumericUpDown Grid.Column="4" Value="{Binding FreeOver}" Minimum="0" Maximum="999"
                                   Increment="1" FormatString="0.00" Height="44" Margin="0,0,4,0"
                                   ShowButtonSpinner="False" />
                    <CheckBox Grid.Column="5" IsChecked="{Binding IsActive}" VerticalAlignment="Center" />
                    <Button Grid.Column="6" Classes="btn" Content="✕" Width="34" Height="44" Padding="0"
                            Command="{Binding #Root.((vm:SettingsViewModel)DataContext).RemoveDeliveryZoneCommand}"
                            CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Classes="btn" Content="Add zone" Width="140" HorizontalAlignment="Left"
                    Command="{Binding AddDeliveryZoneCommand}" Margin="0,4,0,0" />

            <TextBlock Text="How distance is priced" Classes="title" Margin="0,20,0,0" />
            <ComboBox ItemsSource="{Binding DeliveryModes}" SelectedItem="{Binding DeliveryMode}"
                      HorizontalAlignment="Stretch" Height="44" />
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                       Text="Postcode: rules only, and a postcode matching none is outside the area. Miles: road distance bands. Hybrid: rules first, distance as the fallback. This matches the RingOrder website, so a shop running both quotes one price." />

            <Grid ColumnDefinitions="*,*" Margin="0,10,0,0">
              <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Below-minimum surcharge £" Classes="muted" FontSize="12" />
                <NumericUpDown Value="{Binding BelowMinimumSurcharge}" Minimum="0" Maximum="99"
                               Increment="0.5" FormatString="0.00" Height="44" />
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="Maximum delivery miles" Classes="muted" FontSize="12" />
                <NumericUpDown Value="{Binding MaxDeliveryMiles}" Minimum="0" Maximum="50"
                               Increment="0.5" FormatString="0.##" Height="44" />
              </StackPanel>
            </Grid>
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                       Text="The surcharge is a flat amount for carrying a small order, not the shortfall — same as the website. Zero means the till warns and charges nothing. Being under a minimum never blocks the order." />

            <Grid ColumnDefinitions="*,Auto" Margin="0,12,0,0">
              <TextBox Classes="field" Watermark="Test a postcode" Text="{Binding ZoneTestPostcode}" />
              <Button Grid.Column="1" Classes="card" Content="Check" Width="110" Margin="8,0,0,0"
                      Command="{Binding TestZoneCommand}" />
            </Grid>
            <TextBlock Text="{Binding ZoneTestResult}" Classes="muted" TextWrapping="Wrap" FontSize="12" />

            <Button Classes="primary" Content="Save delivery zones" Width="220" Margin="0,12,0,0"
                    HorizontalAlignment="Left" Command="{Binding SaveDeliveryZonesCommand}" />

            <TextBlock Text="Postcode lookup" Classes="title" Margin="0,24,0,0" />
            <TextBlock TextWrapping="Wrap" Classes="muted"
                       Text="Type a postcode on the till, press Find, pick the house. There is no free source of UK house numbers — every provider that has them licenses the Royal Mail address file — so this is off until a shop chooses to turn it on." />

            <ComboBox ItemsSource="{Binding AddressProviders}" SelectedItem="{Binding SelectedAddressProvider}"
                      HorizontalAlignment="Stretch" Height="44" Margin="0,8,0,0" />
            <TextBlock Text="{Binding AddressProviderHint}" Classes="muted" TextWrapping="Wrap" FontSize="12" />

            <TextBox Classes="field" Watermark="API key" Text="{Binding AddressApiKey}"
                     IsVisible="{Binding AddressNeedsKey}" Margin="0,8,0,0" />

            <CheckBox IsChecked="{Binding AddressCacheEnabled}" Margin="0,8,0,0"
                      Content="Remember every answer (recommended)" />
            <TextBlock Text="{Binding AddressCacheSummary}" Classes="muted" TextWrapping="Wrap" FontSize="12" />

            <Grid ColumnDefinitions="*,Auto" Margin="0,12,0,0">
              <TextBox Classes="field" Watermark="Test with a postcode" Text="{Binding AddressTestPostcode}" />
              <Button Grid.Column="1" Classes="card" Content="Test" Width="110" Margin="8,0,0,0"
                      Command="{Binding TestAddressLookupCommand}" />
            </Grid>
            <TextBlock Text="{Binding AddressTestResult}" Classes="muted" TextWrapping="Wrap" FontSize="12" />

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
              <Button Classes="primary" Content="Save postcode lookup" Width="220"
                      Command="{Binding SaveAddressLookupCommand}" />
              <Button Classes="btn" Content="Clear saved addresses" Width="200"
                      Command="{Binding ClearAddressCacheCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="panel" CornerRadius="8" Padding="16" IsVisible="{Binding IsHardware}">
          <StackPanel Spacing="4">
            <TextBlock Text="Printers" Classes="title" Margin="0,0,0,4" />
            <TextBlock Text="{Binding PrinterHint}" Classes="muted" TextWrapping="Wrap" Margin="0,0,0,8" />

            <ItemsControl ItemsSource="{Binding Printers}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PrinterRow">
                  <Border Classes="panel-flat" Padding="12" Margin="0,0,0,10">
                    <StackPanel Spacing="6">
                      <Grid ColumnDefinitions="*,170,Auto">
                        <TextBox Classes="field" Watermark="Name, e.g. Kitchen" Text="{Binding Name}" Margin="0,0,8,0" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding #Root.((vm:SettingsViewModel)DataContext).Transports}"
                                  SelectedItem="{Binding Transport}" Height="44"
                                  HorizontalAlignment="Stretch" Margin="0,0,8,0" />
                        <CheckBox Grid.Column="2" IsChecked="{Binding IsEnabled}" Content="On"
                                  VerticalAlignment="Center" />
                      </Grid>

                      <TextBox Classes="field" Watermark="{Binding AddressHint}" Text="{Binding Address}" />

                      <Grid ColumnDefinitions="Auto,Auto,*">
                        <CheckBox IsChecked="{Binding HasCashDrawer}" Content="Cash drawer plugs in here"
                                  Margin="0,0,16,0" />
                        <TextBlock Grid.Column="1" Text="{Binding PaperWidth, StringFormat={}{0}mm}"
                                   Classes="muted" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding Status}" TextWrapping="Wrap"
                                   Margin="12,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource InkMuted}" />
                      </Grid>

                      <Grid ColumnDefinitions="*,*,*">
                        <Button Classes="btn" Content="Save" Margin="0,0,6,0"
                                Command="{Binding #Root.((vm:SettingsViewModel)DataContext).SavePrinterCommand}"
                                CommandParameter="{Binding}" />
                        <Button Grid.Column="1" Classes="primary" Content="Test print" Margin="0,0,6,0"
                                Command="{Binding #Root.((vm:SettingsViewModel)DataContext).TestPrinterCommand}"
                                CommandParameter="{Binding}" />
                        <Button Grid.Column="2" Classes="btn" Content="Remove"
                                Command="{Binding #Root.((vm:SettingsViewModel)DataContext).DeletePrinterCommand}"
                                CommandParameter="{Binding}" />
                      </Grid>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Classes="btn" Content="+ Add printer" Command="{Binding AddPrinterCommand}"
                    HorizontalAlignment="Left" Width="200" Margin="0,0,0,16" />

            <TextBlock Text="What prints where" Classes="title" Margin="0,8,0,4" />
            <TextBlock Text="Rules run in order and every match fires, so a dish can print at the wok and again on the packing bench."
                       Classes="muted" TextWrapping="Wrap" Margin="0,0,0,8" />
            <ItemsControl ItemsSource="{Binding Routes}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RouteRow">
                  <Border Classes="panel-flat" Padding="12" Margin="0,0,0,8">
                    <StackPanel Spacing="6">
                      <Grid ColumnDefinitions="150,*,*,*,Auto">
                        <ComboBox ItemsSource="{Binding Documents}" SelectedItem="{Binding Document}"
                                  Height="44" HorizontalAlignment="Stretch" Margin="0,0,6,0" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding PrintClassChoices}"
                                  SelectedItem="{Binding PrintClass}" IsEnabled="{Binding ShowsPrintClass}"
                                  Height="44" HorizontalAlignment="Stretch" Margin="0,0,6,0" />
                        <ComboBox Grid.Column="2" ItemsSource="{Binding ServiceTypeChoices}"
                                  SelectedItem="{Binding ServiceType}"
                                  Height="44" HorizontalAlignment="Stretch" Margin="0,0,6,0" />
                        <ComboBox Grid.Column="3" ItemsSource="{Binding ChannelChoices}"
                                  SelectedItem="{Binding Channel}"
                                  Height="44" HorizontalAlignment="Stretch" Margin="0,0,6,0" />
                        <CheckBox Grid.Column="4" IsChecked="{Binding IsEnabled}" Content="On"
                                  VerticalAlignment="Center" />
                      </Grid>

                      <Grid ColumnDefinitions="Auto,*,Auto,90,Auto,*">
                        <TextBlock Text="to" Classes="muted" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding DeviceChoices}"
                                  SelectedItem="{Binding DeviceName}"
                                  Height="44" HorizontalAlignment="Stretch" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="2" Text="copies" Classes="muted" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <NumericUpDown Grid.Column="3" Value="{Binding Copies}" Minimum="1" Maximum="9"
                                       Increment="1" FormatString="0" Height="44" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="4" Text="if it fails" Classes="muted" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox Grid.Column="5" ItemsSource="{Binding FallbackChoices}"
                                  SelectedItem="{Binding FallbackName}"
                                  Height="44" HorizontalAlignment="Stretch" />
                      </Grid>

                      <Grid ColumnDefinitions="*,*">
                        <Button Classes="btn" Content="Save rule" Margin="0,0,6,0"
                                Command="{Binding #Root.((vm:SettingsViewModel)DataContext).SaveRouteCommand}"
                                CommandParameter="{Binding}" />
                        <Button Grid.Column="1" Classes="btn" Content="Remove rule"
                                Command="{Binding #Root.((vm:SettingsViewModel)DataContext).DeleteRouteCommand}"
                                CommandParameter="{Binding}" />
                      </Grid>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Classes="btn" Content="+ Add rule" Command="{Binding AddRouteCommand}"
                    HorizontalAlignment="Left" Width="200" />

            <TextBlock Text="Ticket options" Classes="title" Margin="0,16,0,4" />
            <TextBox Classes="field" Watermark="Encoding gbk|gb18030|utf8" Text="{Binding PrintEncoding}" />
            <CheckBox IsChecked="{Binding PrintChineseAsRaster}" Content="Print Chinese as an image (safer on cheap printers)" Foreground="#1c1917" Margin="0,4" />
            <CheckBox IsChecked="{Binding OpenDrawerOnCash}" Content="Open drawer on cash pay" Foreground="#1c1917" Margin="0,4" />
            <CheckBox IsChecked="{Binding SendKitchenOnPay}" Content="Also print kitchen on Pay if not yet sent" Foreground="#1c1917" Margin="0,4" />
            <CheckBox IsChecked="{Binding PrintFrontOnPay}" Content="Print front receipt on pay" Foreground="#1c1917" Margin="0,4" />
            <CheckBox IsChecked="{Binding PrintVoidKitchenTicket}" Content="Print VOID kitchen ticket on void" Foreground="#1c1917" Margin="0,4" />
            <TextBlock Text="Caller ID" FontWeight="SemiBold" Foreground="#c2410c" Margin="0,12,0,4" />
            <CheckBox IsChecked="{Binding CallerIdEnabled}" Content="Enable Caller ID" Foreground="#1c1917" />
            <TextBox Classes="field" Watermark="Mode: simulate | serial" Text="{Binding CallerIdMode}" />
            <TextBox Classes="field" Watermark="COM port" Text="{Binding CallerIdCom}" />
            <TextBlock TextWrapping="Wrap" Foreground="#57534e" FontSize="12"
                       Text="serial drives a Caller ID box or modem on a COM port, including the virtual port a USB device presents. A withheld number shows as such rather than as a caller named P. Takes effect on restart." />

            <TextBlock Text="Card terminal" FontWeight="Bold" Margin="0,12,0,0" Foreground="#1c1917" />
            <TextBox Classes="field" Watermark="Mode: manual | simulated" Text="{Binding CardTerminalMode}" />
            <TextBlock TextWrapping="Wrap" Foreground="#57534e" FontSize="12"
                       Text="manual is a standalone card machine the cashier runs by hand — the till records what they say happened. simulated exercises the integrated flow, including a lost answer, with no hardware. Takes effect on restart." />
            <StackPanel IsVisible="{Binding IsSimulatedTerminal}" Spacing="6" Margin="0,6,0,0">
              <TextBlock TextWrapping="Wrap" Foreground="#57534e" FontSize="12"
                         Text="Arm the next card payment to fail. A real terminal cannot be asked to decline on demand, which is why these paths otherwise reach a merchant untested." />
              <Grid ColumnDefinitions="*,*">
                <Button Classes="btn" Content="Next card declines" Height="40" Margin="0,0,4,0"
                        Command="{Binding ArmCardDeclineCommand}" />
                <Button Grid.Column="1" Classes="btn" Content="Next card loses its answer" Height="40" Margin="4,0,0,0"
                        Command="{Binding ArmCardLostAnswerCommand}" />
              </Grid>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
              <Button Classes="primary" Content="Test print" Command="{Binding TestPrintCommand}" Width="140" />
              <Button Classes="btn" Content="Open drawer (PIN)" Command="{Binding OpenDrawerCommand}" Width="160" Height="52" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="panel" Padding="16" IsVisible="{Binding IsStaff}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
              <TextBlock Text="Staff" Classes="title" />
              <TextBlock Text="{Binding StaffHint}" Classes="muted" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="*,160,Auto">
                <TextBox Classes="field" Watermark="Name" Text="{Binding NewStaffName}" Margin="0,0,8,0" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding StaffRoles}"
                          SelectedItem="{Binding NewStaffRole}" Height="44" Margin="0,0,8,0"
                          HorizontalAlignment="Stretch" />
                <Button Grid.Column="2" Classes="primary" Content="Add staff"
                        Command="{Binding AddStaffCommand}" Width="140" />
              </Grid>
            </StackPanel>

            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding StaffMembers}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:StaffRow">
                    <Border Classes="panel-flat" Padding="12" Margin="0,0,0,8">
                      <Grid ColumnDefinitions="*,150,Auto,Auto">
                        <StackPanel VerticalAlignment="Center">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <Border Classes="pill warn" IsVisible="{Binding NeedsAttention}">
                              <TextBlock Text="{Binding Status}" />
                            </Border>
                            <Border Classes="pill ok" IsVisible="{Binding IsCurrent}">
                              <TextBlock Text="Signed in" />
                            </Border>
                          </StackPanel>
                          <TextBlock Text="Switched off" Classes="muted"
                                     IsVisible="{Binding !IsActive}" />
                        </StackPanel>

                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding #Root.((vm:SettingsViewModel)DataContext).StaffRoles}"
                                  SelectedItem="{Binding SelectedRole}" Height="44"
                                  HorizontalAlignment="Stretch" Margin="0,0,8,0" />

                        <Button Grid.Column="2" Classes="btn" Content="Save role" Width="110"
                                Margin="0,0,8,0"
                                Command="{Binding #Root.((vm:SettingsViewModel)DataContext).SetStaffRoleCommand}"
                                CommandParameter="{Binding}" />

                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                          <Button Classes="btn" Content="Change PIN" Width="130"
                                  Command="{Binding #Root.((vm:SettingsViewModel)DataContext).ChangeStaffPinCommand}"
                                  CommandParameter="{Binding}" />
                          <Button Classes="btn" Content="{Binding ActiveLabel}" Width="120"
                                  Command="{Binding #Root.((vm:SettingsViewModel)DataContext).ToggleStaffActiveCommand}"
                                  CommandParameter="{Binding}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <Border Classes="panel" Padding="16" IsVisible="{Binding IsTax}">
          <StackPanel Spacing="10">
            <TextBlock Text="VAT" Classes="title" />
            <TextBlock Text="{Binding TaxHint}" Classes="muted" TextWrapping="Wrap" />

            <TextBox Classes="field" Watermark="VAT number — leave blank if not registered"
                     Text="{Binding VatNumber}" />
            <CheckBox IsChecked="{Binding PricesIncludeTax}"
                      Content="Menu prices already include VAT (normal for UK retail)" />

            <TextBlock Text="Rates" Classes="title" Margin="0,12,0,0" />
            <ItemsControl ItemsSource="{Binding TaxClasses}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TaxClassRow">
                  <Grid ColumnDefinitions="160,*,120" Margin="0,0,0,6">
                    <TextBlock Text="{Binding Id}" Classes="muted" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Classes="field" Text="{Binding Name}" Margin="0,0,8,0" />
                    <NumericUpDown Grid.Column="2" Value="{Binding RatePercent}" Minimum="0" Maximum="100"
                                   Increment="0.5" FormatString="0.##" Height="44" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="A dish takes its rate from its category unless it sets its own. Delivery follows the shop's default rate."
                       Classes="muted" TextWrapping="Wrap" />

            <TextBlock Text="Receipt footer" Classes="title" Margin="0,12,0,0" />
            <TextBox Classes="field" Text="{Binding ReceiptFooter}" AcceptsReturn="True"
                     MinHeight="90" Watermark="Thank you — see you again" />

            <Button Classes="primary" Content="Save VAT settings" Command="{Binding SaveTaxCommand}"
                    HorizontalAlignment="Left" Width="220" Margin="0,8,0,0" />
          </StackPanel>
        </Border>

        <!--
          Customer data: the shop is the data controller, so this screen states
          the obligation and shows the count, and leaves the decision to them.
          Nothing here happens on a timer the merchant did not ask for.
        -->
        <Border Classes="panel" Padding="16" IsVisible="{Binding IsPrivacy}">
          <StackPanel Spacing="10">
            <TextBlock Text="Customer data" Classes="title" />
            <TextBlock TextWrapping="Wrap" Classes="muted"
                       Text="A name with an address is personal data. This till keeps the place and the person apart: streets are shared and stay, while names, phone numbers, saved addresses and driver notes belong to the customer and can be removed on request." />

            <TextBlock Text="Keep customers for" Classes="title" Margin="0,12,0,0" />
            <Grid ColumnDefinitions="140,*">
              <NumericUpDown Value="{Binding RetentionMonths}" Minimum="0" Maximum="120"
                             Increment="6" FormatString="0" Height="44" />
              <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"
                         Classes="muted" Text="months of inactivity — 0 keeps everything" />
            </Grid>

            <Border Classes="panel-flat" Padding="12">
              <TextBlock Text="{Binding RetentionSummary}" TextWrapping="Wrap" />
            </Border>

            <CheckBox IsChecked="{Binding RetentionAutomatic}"
                      Content="Erase dormant records automatically once a period is set" />

            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
              <Button Classes="primary" Content="Save retention" Width="180"
                      Command="{Binding SaveRetentionCommand}" />
              <Button Classes="danger" Content="Erase dormant now" Width="200"
                      Command="{Binding EraseDormantCommand}"
                      IsEnabled="{Binding HasDormantCustomers}" />
            </StackPanel>

            <TextBlock TextWrapping="Wrap" Classes="muted" FontSize="12" Margin="0,8,0,0"
                       Text="Erasing removes the customer, their saved addresses and the driver notes attached to them, and strips the name, phone, address and web-order payload from their past orders. The orders themselves — takings and VAT — are kept, because HMRC requires six years." />
          </StackPanel>
        </Border>

        <!--
          Support: everything a remote session needs on one screen, so nobody
          has to ask the merchant to read a version number down the phone.
        -->
        <Border Classes="panel" Padding="16" IsVisible="{Binding IsCloud}">
          <StackPanel Spacing="10" MaxWidth="620" HorizontalAlignment="Left">
            <TextBlock Text="Cloud" Classes="title" />

            <Border Classes="panel-flat" Padding="14">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding CloudStatus}" FontWeight="Bold" FontSize="18" Foreground="#1c1917" />
                <TextBlock Text="{Binding CloudDetail}" TextWrapping="Wrap" Foreground="#57534e" FontSize="13" />
              </StackPanel>
            </Border>

            <!-- Connecting: shown only while there is nothing to show instead. -->
            <StackPanel Spacing="8" IsVisible="{Binding !CloudConnected}">
              <TextBlock Text="Enter the activation code" Classes="title" Margin="0,8,0,0" />
              <TextBlock TextWrapping="Wrap" Classes="muted" FontSize="12"
                         Text="Eight characters, as we sent them. Upper or lower case, with or without the dash." />
              <Grid ColumnDefinitions="*,Auto">
                <!-- Case and dashes are forgiven by the service, so the box does
                     not fight the person typing. -->
                <TextBox Text="{Binding CloudCode}" Watermark="XXXX-XXXX" Height="56" Margin="0,0,8,0"
                         FontSize="22" FontFamily="Consolas, Cascadia Mono, monospace"
                         MaxLength="12" />
                <Button Grid.Column="1" Classes="primary" Content="Connect" Width="150" Height="56"
                        IsEnabled="{Binding !CloudBusy}" Command="{Binding ConnectCloudCommand}" />
              </Grid>
            </StackPanel>

            <Button Classes="btn" Content="Check now" Width="180" Height="44"
                    IsVisible="{Binding CloudConnected}" IsEnabled="{Binding !CloudBusy}"
                    Command="{Binding CheckCloudCommand}" />

            <TextBlock Text="{Binding CloudResult}" TextWrapping="Wrap" Foreground="#1c1917" FontSize="13" />

            <TextBlock Text="This machine" Classes="title" Margin="0,16,0,0" />
            <TextBlock TextWrapping="Wrap" Classes="muted" FontSize="12"
                       Text="Quote this if you ring us. It identifies this till and nothing about the shop." />
            <SelectableTextBlock Text="{Binding CloudDeviceId}" FontFamily="Consolas, Cascadia Mono, monospace"
                                 FontSize="13" Foreground="#57534e" />
          </StackPanel>
        </Border>

        <Border Classes="panel" Padding="16" IsVisible="{Binding IsSupport}">
          <StackPanel Spacing="10">
            <TextBlock Text="Support" Classes="title" />
            <Border Classes="panel-flat" Padding="12">
              <TextBlock Text="{Binding SupportSummary}" FontFamily="Consolas, Cascadia Mono, monospace"
                         FontSize="{StaticResource FontSmall}" TextWrapping="Wrap" />
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="primary" Content="Export diagnostics" Width="220"
                      Command="{Binding ExportDiagnosticsCommand}" />
              <Button Classes="btn" Content="Back up now" Width="180"
                      Command="{Binding BackupNowCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding SupportResult}" Classes="muted" TextWrapping="Wrap" />

            <TextBlock Text="Restore from a backup" Classes="title" Margin="0,12,0,0" />
            <TextBlock TextWrapping="Wrap" Foreground="#b91c1c" FontSize="12"
                       Text="Everything taken since the backup was made is lost. The till keeps a copy of the current database first, so a restore can itself be undone. Applied on the next start, never while trading." />
            <ListBox Classes="ticket" MaxHeight="200" ItemsSource="{Binding Backups}"
                     SelectedItem="{Binding SelectedBackup}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:BackupRow">
                  <Grid ColumnDefinitions="*,Auto" Margin="6,6">
                    <StackPanel>
                      <TextBlock Text="{Binding Label}" Foreground="#1c1917" FontSize="13" />
                      <TextBlock Text="{Binding Kind}" Foreground="#57534e" FontSize="11" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Size}" Foreground="#57534e" FontSize="12" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Button Classes="btn" Content="Restore this backup on next start" Height="44"
                    Command="{Binding RestoreBackupCommand}" />

            <TextBlock Text="Tickets the printer gave up on" Classes="title" Margin="0,12,0,0"
                       IsVisible="{Binding HasFailedJobs}" />
            <TextBlock Text="Check the printer first, then send it again. These are not retried on their own — a queue that never stops is how a kitchen gets forty copies of one order."
                       Classes="muted" TextWrapping="Wrap" IsVisible="{Binding HasFailedJobs}" />
            <ItemsControl ItemsSource="{Binding FailedJobs}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="domain:PrintJob">
                  <Border Classes="panel-flat" Padding="12" Margin="0,0,0,6">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel>
                        <TextBlock FontWeight="SemiBold">
                          <Run Text="{Binding OrderNumber}" />
                          <Run Text=" · " />
                          <Run Text="{Binding Document}" />
                        </TextBlock>
                        <TextBlock Text="{Binding Error}" Classes="muted" TextWrapping="Wrap" />
                      </StackPanel>
                      <Button Grid.Column="1" Classes="primary" Content="Send again" Width="150"
                              Command="{Binding #Root.((vm:SettingsViewModel)DataContext).RetryFailedJobCommand}"
                              CommandParameter="{Binding}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Classes="panel" CornerRadius="8" Padding="16" IsVisible="{Binding IsShift}">
          <StackPanel Spacing="8">
            <TextBlock Text="Shift readings / 班次报表" FontWeight="Bold" FontSize="18" Foreground="#1c1917" />
            <TextBlock TextWrapping="Wrap" Foreground="#57534e"
                       Text="An X reading looks at the open shift and changes nothing. A Z reading is the closing account, printed automatically when the shift is closed and reprintable here at any time." />

            <TextBox Text="{Binding ShiftSummary}" IsReadOnly="True" AcceptsReturn="True"
                     Classes="field" MinHeight="240" FontFamily="Consolas,Menlo,monospace" />

            <Button Classes="primary" Content="Print X reading" Height="44"
                    Command="{Binding PrintXReadingCommand}" IsEnabled="{Binding HasOpenShiftReading}" />

            <TextBlock Text="Closed shifts" FontWeight="Bold" Margin="0,8,0,0" Foreground="#1c1917" />
            <ListBox Classes="ticket" MaxHeight="220" ItemsSource="{Binding ShiftHistory}"
                     SelectedItem="{Binding SelectedShift}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ShiftHistoryRow">
                  <Grid ColumnDefinitions="*,Auto" Margin="6,6">
                    <TextBlock Text="{Binding Label}" Foreground="#1c1917" FontSize="13" />
                    <TextBlock Grid.Column="1" Text="{Binding Variance}" FontSize="13" FontWeight="Bold"
                               Foreground="{Binding IsOut, Converter={x:Static conv:BoolToVarianceBrush.Instance}}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Grid ColumnDefinitions="*,*">
              <Button Classes="btn" Content="View reading" Height="44" Margin="0,0,4,0"
                      Command="{Binding ViewZReadingCommand}" />
              <Button Grid.Column="1" Classes="btn" Content="Reprint Z" Height="44" Margin="4,0,0,0"
                      Command="{Binding ReprintZReadingCommand}" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="panel" CornerRadius="8" Padding="16" IsVisible="{Binding IsNotes}">
          <StackPanel Spacing="8">
            <TextBlock Text="Quick notes / 快捷备注" FontWeight="Bold" FontSize="18" Foreground="#1c1917" />
            <Grid ColumnDefinitions="*,*,Auto,Auto">
              <TextBox Classes="field" Watermark="English" Text="{Binding NewNoteEn}" Margin="0,0,6,0" />
              <TextBox Grid.Column="1" Classes="field" Watermark="厨房中文" Text="{Binding NewNoteZh}" Margin="0,0,6,0" />
              <Button Grid.Column="2" Classes="primary" Content="Add" Command="{Binding AddNoteCommand}" Width="80" Height="40" />
            </Grid>
            <ItemsControl ItemsSource="{Binding NoteRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:QuickNoteEditRow">
                  <Grid ColumnDefinitions="*,*,Auto" Margin="0,4">
                    <TextBox Classes="field" Text="{Binding En}" Margin="0,0,6,0" />
                    <TextBox Grid.Column="1" Classes="field" Text="{Binding Zh}" Margin="0,0,6,0" />
                    <Button Grid.Column="2" Classes="btn" Content="Del"
                            Command="{Binding #Root.((vm:SettingsViewModel)DataContext).RemoveNoteCommand}"
                            CommandParameter="{Binding}" Width="64" Height="40" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Save settings to apply notes on Till." Foreground="#5b6472" FontSize="12" />
          </StackPanel>
        </Border>

        <Border Classes="panel" CornerRadius="8" Padding="16" IsVisible="{Binding IsOnline}">
          <StackPanel Spacing="4">
            <TextBlock Text="Online (Advanced) / 线上" FontWeight="Bold" FontSize="18" Foreground="#1c1917" Margin="0,0,0,4" />
            <TextBlock Text="Copy a / u / p from website Admin → Print. Stored locally only."
                       FontSize="12" Foreground="#5b6472" TextWrapping="Wrap" Margin="0,0,0,8" />
            <TextBox Classes="field" Watermark="Base URL" Text="{Binding OnlineBaseUrl}" />
            <Button Classes="btn" Content="Apply base URL → endpoints" Command="{Binding ApplyBaseUrlCommand}"
                    HorizontalAlignment="Left" Width="260" Height="40" Margin="0,0,0,8" />
            <TextBox Classes="field" Watermark="Next URL" Text="{Binding OrderServerUrl}" />
            <TextBox Classes="field" Watermark="Ack URL" Text="{Binding PrintedUrl}" />
            <TextBox Classes="field" Watermark="Res ID (a)" Text="{Binding OnlineResId}" />
            <TextBox Classes="field" Watermark="Username (u)" Text="{Binding OnlineUsername}" />
            <TextBox Classes="field" Watermark="Password (p)" Text="{Binding OnlinePassword}" PasswordChar="•" />
            <TextBox Classes="field" Watermark="Poll interval seconds" Text="{Binding PollIntervalText}" />
            <CheckBox IsChecked="{Binding OnlinePollingEnabled}" Content="Start accepting web orders when the till starts" Foreground="#1c1917" Margin="0,4" />
            <CheckBox IsChecked="{Binding AutoKitchenPrintOnline}" Content="Print web orders to the kitchen automatically" Foreground="#1c1917" Margin="0,4" />

            <!-- Proving the credentials at install time, before the shop opens. -->
            <Button Classes="primary" Content="Test connection" Command="{Binding TestWebOrdersCommand}"
                    HorizontalAlignment="Left" Width="220" Margin="0,12,0,0" />
            <TextBlock Text="{Binding WebTestResult}" Classes="muted" TextWrapping="Wrap" Margin="0,8,0,0" />
            <TextBlock Text="Turning the feed on and off during service is the button in the top bar."
                       Classes="muted" TextWrapping="Wrap" Margin="0,8,0,0" />
          </StackPanel>
        </Border>

      </StackPanel>

      <!-- Menu operations: categories · dishes · full editor -->
      <Border Classes="panel" CornerRadius="8" Padding="12" IsVisible="{Binding IsMenu}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,10">
              <TextBlock Text="{Binding LblMenuOpsTitle}" FontWeight="Bold" FontSize="18" Foreground="#1c1917" />
              <TextBlock Text="{Binding LblMenuOpsHint}"
                         Foreground="#5b6472" FontSize="12" TextWrapping="Wrap" />
              <TextBlock Text="{Binding MenuInfo}" Foreground="#5b6472" FontSize="11" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Classes="field" Watermark="Search # / name" Text="{Binding MenuSearch}" Margin="0,0,8,0" />
                <Button Grid.Column="1" Classes="btn" Content="{Binding LblReimport}"
                        Command="{Binding ReimportMenuCommand}" MinWidth="140" Height="40" />
              </Grid>
            </StackPanel>

            <Grid ColumnDefinitions="170,210,*" MinHeight="520">
              <!-- Categories -->
              <Border Background="#f4f6f8" CornerRadius="8" Padding="8" Margin="0,0,8,0">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
                    <TextBlock Text="{Binding LblCategories}" FontWeight="SemiBold" Foreground="#c2410c" />
                    <Button Classes="primary" Content="{Binding LblAddCategory}" Command="{Binding AddCategoryCommand}" Height="40" />
                    <Grid ColumnDefinitions="*,*,*" >
                      <Button Classes="btn" Content="{Binding LblEdit}" Command="{Binding BeginEditCategoryCommand}" Height="36" Margin="0,0,4,0" />
                      <Button Grid.Column="1" Classes="btn" Content="{Binding LblHideShow}" Command="{Binding ToggleCategoryVisibleCommand}"
                              CommandParameter="{Binding SelectedMenuCategory}" Height="36" Margin="0,0,4,0" />
                      <Button Grid.Column="2" Classes="btn" Content="{Binding LblDelete}" Command="{Binding DeleteCategoryCommand}" Height="36" />
                    </Grid>
                  </StackPanel>
                  <ListBox Classes="ticket" ItemsSource="{Binding MenuCategories}" SelectedItem="{Binding SelectedMenuCategory}">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:CategoryAdminRow">
                        <StackPanel Margin="6,6">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#1c1917" TextWrapping="Wrap" FontSize="13" />
                          <TextBlock Text="{Binding VisibilityText}" FontSize="11" Foreground="#5b6472" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </DockPanel>
              </Border>

              <!-- Dishes -->
              <Border Grid.Column="1" Background="#f4f6f8" CornerRadius="8" Padding="8" Margin="0,0,8,0">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
                    <TextBlock Text="{Binding LblDishes}" FontWeight="SemiBold" Foreground="#c2410c" />
                    <Button Classes="cash" Content="{Binding LblAddDish}" Command="{Binding AddDishCommand}" Height="40" />
                  </StackPanel>
                  <ListBox Classes="ticket" ItemsSource="{Binding MenuRows}" SelectedItem="{Binding SelectedMenuItem}">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:MenuEditRow">
                        <StackPanel Margin="6,6">
                          <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="#1c1917" TextWrapping="Wrap" FontSize="13" />
                          <TextBlock FontSize="11" Foreground="#5b6472">
                            <Run Text="{Binding Item.BasePrice, StringFormat={}£{0:0.00}}" />
                            <Run Text=" · " />
                            <Run Text="{Binding StatusText}" />
                            <Run Text=" · " />
                            <Run Text="{Binding OptionsBadge}" />
                          </TextBlock>
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </DockPanel>
              </Border>

              <!-- Editor pane -->
              <Border Grid.Column="2" Background="#f4f6f8" CornerRadius="8" Padding="12">
                <Panel>
                  <!-- Category editor -->
                  <StackPanel IsVisible="{Binding EditingCategory}" Spacing="8" MaxWidth="420">
                    <TextBlock Text="Edit category" FontWeight="Bold" FontSize="16" Foreground="#1c1917" />
                    <TextBox Classes="field" Watermark="Name" Text="{Binding CategoryEditName}" />
                    <TextBox Classes="field" Watermark="Sort order" Text="{Binding CategoryEditSort}" />
                    <CheckBox IsChecked="{Binding CategoryEditVisible}" Content="Visible on the till" Foreground="#1c1917" />
                    <TextBlock Text="Cooked at" Classes="muted" Margin="0,8,0,0" />
                    <ComboBox ItemsSource="{Binding PrintClasses}" SelectedItem="{Binding CategoryEditPrintClass}"
                              Height="44" HorizontalAlignment="Stretch" />
                    <TextBlock Text="Decides which printer these dishes reach. Set it per section — a shop thinks in sections, not in forty individual dishes."
                               Classes="muted" TextWrapping="Wrap" />
                    <Button Classes="cash" Content="Save category" Command="{Binding SaveCategoryCommand}" Width="180" />
                  </StackPanel>

                  <!-- Dish editor -->
                  <DockPanel IsVisible="{Binding HasDishEditor}">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                      <Button Classes="cash" Content="{Binding LblSaveDish}" Command="{Binding SaveDishCommand}" Width="130" Height="48" />
                      <Button Classes="btn" Content="{Binding LblDuplicate}" Command="{Binding DuplicateDishCommand}" Width="100" Height="48" />
                      <Button Classes="btn" Content="{Binding Lbl86}" Command="{Binding Toggle86CurrentCommand}" Width="72" Height="48" />
                      <Button Classes="danger" Content="{Binding LblDelete}" Command="{Binding DeleteDishCommand}" Width="90" Height="48" />
                    </StackPanel>
                    <ScrollViewer>
                      <StackPanel Spacing="8" Margin="0,0,8,0">
                        <TextBlock Text="{Binding LblDishEditor}" FontWeight="Bold" FontSize="16" Foreground="#1c1917" />
                        <TextBlock Text="{Binding DishEditor.ValidationMessage}" Foreground="#b91c1c" TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="*,*">
                          <TextBox Classes="field" Watermark="Menu # (e.g. 54)" Text="{Binding DishEditor.MenuNumber}" Margin="0,0,6,0" />
                          <ComboBox Grid.Column="1" ItemsSource="{Binding DishEditor.Categories}"
                                    SelectedItem="{Binding DishEditor.SelectedCategory}"
                                    PlaceholderText="Category" Height="34" />
                        </Grid>
                        <TextBox Classes="field" Watermark="Front name (English)" Text="{Binding DishEditor.Name}" />
                        <TextBox Classes="field" Watermark="Kitchen name (中文 · print)" Text="{Binding DishEditor.KitchenName}" />
                        <Grid ColumnDefinitions="*,80">
                          <TextBox Classes="field" Watermark="Price £" Text="{Binding DishEditor.PriceText}" Margin="0,0,6,0" />
                          <TextBox Grid.Column="1" Classes="field" Watermark="Sort" Text="{Binding DishEditor.SortOrderText}" />
                        </Grid>
                        <CheckBox IsChecked="{Binding DishEditor.IsAvailable}" Content="On sale (uncheck = 86)" Foreground="#1c1917" />
                        <Grid ColumnDefinitions="Auto,*">
                          <TextBlock Text="Cooked at" Classes="muted" VerticalAlignment="Center" Margin="0,0,8,0" />
                          <ComboBox Grid.Column="1" ItemsSource="{Binding PrintClassesWithInherit}"
                                    SelectedItem="{Binding DishEditor.PrintClass}"
                                    Height="44" HorizontalAlignment="Stretch"
                                    ToolTip.Tip="Leave blank to follow the category" />
                        </Grid>
                        <TextBox Classes="field" Watermark="Description / staff hint" Text="{Binding DishEditor.Description}" />

                        <Grid ColumnDefinitions="*,Auto" Margin="0,12,0,4">
                          <TextBlock Text="{Binding LblOptionGroups}" FontWeight="Bold" Foreground="#c2410c" VerticalAlignment="Center" />
                          <Button Grid.Column="1" Classes="btn" Content="{Binding LblAddGroup}" Command="{Binding AddOptionGroupCommand}"
                                  MinWidth="90" Height="36" />
                        </Grid>
                        <TextBlock Text="Single = pick one · Multi = checkbox with min/max · Conditional = show when another choice picked"
                                   Foreground="#5b6472" FontSize="11" TextWrapping="Wrap" />

                        <ItemsControl ItemsSource="{Binding DishEditor.Groups}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:OptionGroupEditorVm">
                              <Border Background="#ffffff" CornerRadius="8" Padding="10" Margin="0,0,0,10"
                                      BorderBrush="#d0d5dd" BorderThickness="1">
                                <StackPanel Spacing="6">
                                  <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Classes="field" Text="{Binding Name}" Watermark="Group name" Margin="0,0,6,0" />
                                    <Button Grid.Column="1" Classes="btn" Content="{Binding #Root.((vm:SettingsViewModel)DataContext).LblRemove}"
                                            Command="{Binding #Root.((vm:SettingsViewModel)DataContext).RemoveOptionGroupCommand}"
                                            CommandParameter="{Binding}" Width="80" Height="34" FontSize="11" Margin="0" />
                                  </Grid>
                                  <Grid ColumnDefinitions="*,Auto,70,70">
                                    <ComboBox ItemsSource="{Binding #Root.((vm:SettingsViewModel)DataContext).OptionTypeChoices}"
                                              SelectedItem="{Binding SelectedType}" Height="34" Margin="0,0,6,0" />
                                    <CheckBox Grid.Column="1" IsChecked="{Binding Required}"
                                              Content="{Binding #Root.((vm:SettingsViewModel)DataContext).LblRequired}"
                                              Foreground="#1c1917" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox Grid.Column="2" Classes="field" Text="{Binding MinText}" Watermark="Min"
                                             IsVisible="{Binding IsMulti}" Margin="0,0,4,0" />
                                    <TextBox Grid.Column="3" Classes="field" Text="{Binding MaxText}" Watermark="Max"
                                             IsVisible="{Binding IsMulti}" />
                                  </Grid>
                                  <TextBlock Text="Show when (conditional)" FontSize="11" Foreground="#5b6472" />
                                  <ComboBox ItemsSource="{Binding ParentGroupOptions}" SelectedItem="{Binding SelectedShowWhen}"
                                            Height="34" />
                                  <Button Classes="btn" Content="Refresh conditional list" Command="{Binding #Root.((vm:SettingsViewModel)DataContext).RefreshShowWhenCommand}"
                                          Height="32" HorizontalAlignment="Left" Width="180" FontSize="11" />

                                  <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding #Root.((vm:SettingsViewModel)DataContext).LblChoices}" FontWeight="SemiBold" Foreground="#c2410c" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Classes="btn" Content="{Binding #Root.((vm:SettingsViewModel)DataContext).LblAddChoice}"
                                            Command="{Binding #Root.((vm:SettingsViewModel)DataContext).AddChoiceCommand}"
                                            CommandParameter="{Binding}" MinWidth="90" Height="32" FontSize="11" />
                                  </Grid>
                                  <ItemsControl ItemsSource="{Binding Choices}">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate x:DataType="vm:OptionChoiceEditorVm">
                                        <Border Classes="panel" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                                          <StackPanel Spacing="4">
                                            <Grid ColumnDefinitions="*,*,56,Auto">
                                              <TextBox Classes="field" Text="{Binding Label}" Watermark="Label" Margin="0,0,4,0" />
                                              <TextBox Grid.Column="1" Classes="field" Text="{Binding KitchenName}" Watermark="中文" Margin="0,0,4,0" />
                                              <TextBox Grid.Column="2" Classes="field" Text="{Binding PriceDeltaText}" Watermark="+£ / 0" Margin="0,0,4,0" />
                                              <Button Grid.Column="3" Classes="btn" Content="×"
                                                      Command="{Binding #Root.((vm:SettingsViewModel)DataContext).RemoveChoiceCommand}"
                                                      CommandParameter="{Binding}" Width="36" Height="32" Margin="0" />
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                              <CheckBox IsChecked="{Binding IsDefault}" Content="Default" Foreground="#5b6472" />
                                              <CheckBox IsChecked="{Binding IsAvailable}" Content="Available" Foreground="#5b6472" />
                                            </StackPanel>
                                          </StackPanel>
                                        </Border>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </ScrollViewer>
                  </DockPanel>

                  <TextBlock Text="Select a category/dish, or create new." Foreground="#5b6472"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             IsVisible="{Binding ShowEmptyEditorHint}" />
                </Panel>
              </Border>
            </Grid>
          </DockPanel>
      </Border>
      </Panel>
    </ScrollViewer>
  </Grid>
</UserControl>
