<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RingOrder.Epos.ViewModels"
             xmlns:conv="using:RingOrder.Epos.Converters"
             x:Class="RingOrder.Epos.Views.SettingsView"
             x:Name="Root"
             x:DataType="vm:SettingsViewModel"
             Background="{StaticResource Page}">
  <Grid ColumnDefinitions="168,*" Margin="4">
    <Border Classes="panel" CornerRadius="8" Padding="8" Margin="0,0,8,0">
      <StackPanel>
        <Button Classes="btn" Classes.on="{Binding IsShop}" Content="{Binding LblSecShop}" Command="{Binding GoSectionCommand}" CommandParameter="Shop" />
        <Button Classes="btn" Classes.on="{Binding IsMenu}" Content="{Binding LblSecMenu}" Command="{Binding GoSectionCommand}" CommandParameter="Menu" />
        <Button Classes="btn" Classes.on="{Binding IsNotes}" Content="{Binding LblSecNotes}" Command="{Binding GoSectionCommand}" CommandParameter="Notes" />
        <Button Classes="btn" Classes.on="{Binding IsDelivery}" Content="{Binding LblSecDelivery}" Command="{Binding GoSectionCommand}" CommandParameter="Delivery" />
        <Button Classes="btn" Classes.on="{Binding IsHardware}" Content="{Binding LblSecHardware}" Command="{Binding GoSectionCommand}" CommandParameter="Hardware" />
        <Button Classes="btn" Classes.on="{Binding IsStaff}" Content="{Binding LblSecStaff}" Command="{Binding GoSectionCommand}" CommandParameter="Staff" />
        <Button Classes="btn" Classes.on="{Binding IsShift}" Content="{Binding LblSecShift}" Command="{Binding GoSectionCommand}" CommandParameter="Shift" />
        <Button Classes="btn" Classes.on="{Binding IsOnline}" Content="{Binding LblSecOnline}" Command="{Binding GoSectionCommand}" CommandParameter="Online" Margin="0,12,0,0" />
        <Button Classes="cash" Content="{Binding LblSave}" Command="{Binding SaveCommand}" Height="52" Margin="0,16,0,0" />
        <TextBlock Text="{Binding LblUiLangNote}" Classes="muted" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0" />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Column="1">
      <Panel>
      <StackPanel MaxWidth="820" IsVisible="{Binding !IsMenu}">

        <Border Classes="panel" CornerRadius="8" Padding="16" IsVisible="{Binding IsShop}">
          <StackPanel Spacing="4">
            <TextBlock Text="Shop / 店铺" FontWeight="Bold" FontSize="18" Foreground="#1c1917" Margin="0,0,0,8" />
            <TextBox Classes="field" Watermark="Shop name" Text="{Binding ShopName}" />
            <TextBox Classes="field" Watermark="Address" Text="{Binding ShopAddress}" />
            <TextBox Classes="field" Watermark="Postcode" Text="{Binding ShopPostcode}" />
            <TextBox Classes="field" Watermark="Phone" Text="{Binding ShopPhone}" />
          </StackPanel>
        </Border>

        <Border Classes="panel" CornerRadius="8" Padding="16" IsVisible="{Binding IsDelivery}">
          <StackPanel Spacing="4">
            <TextBlock Text="Delivery / 外卖费" FontWeight="Bold" FontSize="18" Foreground="#1c1917" Margin="0,0,0,8" />
            <TextBox Classes="field" Watermark="Default delivery fee £" Text="{Binding DefaultDeliveryFeeText}" />
            <TextBlock Text="Advanced postcode bands can be added later." Foreground="#5b6472" FontSize="12" Margin="0,8,0,0" />
          </StackPanel>
        </Border>

        <Border Classes="panel" CornerRadius="8" Padding="16" IsVisible="{Binding IsHardware}">
          <StackPanel Spacing="4">
            <TextBlock Text="Printers" Classes="title" Margin="0,0,0,4" />
            <TextBlock Text="{Binding PrinterHint}" Classes="muted" TextWrapping="Wrap" Margin="0,0,0,8" />

            <ItemsControl ItemsSource="{Binding Printers}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PrinterRow">
                  <Border Classes="panel-flat" Padding="12" Margin="0,0,0,10">
                    <StackPanel Spacing="6">
                      <Grid ColumnDefinitions="*,170,Auto">
                        <TextBox Classes="field" Watermark="Name, e.g. Kitchen" Text="{Binding Name}" Margin="0,0,8,0" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding DataContext.Transports, ElementName=Root}"
                                  SelectedItem="{Binding Transport}" Height="44"
                                  HorizontalAlignment="Stretch" Margin="0,0,8,0" />
                        <CheckBox Grid.Column="2" IsChecked="{Binding IsEnabled}" Content="On"
                                  VerticalAlignment="Center" />
                      </Grid>

                      <TextBox Classes="field" Watermark="{Binding AddressHint}" Text="{Binding Address}" />

                      <Grid ColumnDefinitions="Auto,Auto,*">
                        <CheckBox IsChecked="{Binding HasCashDrawer}" Content="Cash drawer plugs in here"
                                  Margin="0,0,16,0" />
                        <TextBlock Grid.Column="1" Text="{Binding PaperWidth, StringFormat={}{0}mm}"
                                   Classes="muted" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding Status}" TextWrapping="Wrap"
                                   Margin="12,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource InkMuted}" />
                      </Grid>

                      <Grid ColumnDefinitions="*,*,*">
                        <Button Classes="btn" Content="Save" Margin="0,0,6,0"
                                Command="{Binding DataContext.SavePrinterCommand, ElementName=Root}"
                                CommandParameter="{Binding}" />
                        <Button Grid.Column="1" Classes="primary" Content="Test print" Margin="0,0,6,0"
                                Command="{Binding DataContext.TestPrinterCommand, ElementName=Root}"
                                CommandParameter="{Binding}" />
                        <Button Grid.Column="2" Classes="btn" Content="Remove"
                                Command="{Binding DataContext.DeletePrinterCommand, ElementName=Root}"
                                CommandParameter="{Binding}" />
                      </Grid>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Classes="btn" Content="+ Add printer" Command="{Binding AddPrinterCommand}"
                    HorizontalAlignment="Left" Width="200" Margin="0,0,0,16" />

            <TextBlock Text="What prints where" Classes="title" Margin="0,8,0,4" />
            <TextBlock Text="Rules run in order and every match fires, so a dish can print at the wok and again on the packing bench."
                       Classes="muted" TextWrapping="Wrap" Margin="0,0,0,8" />
            <ItemsControl ItemsSource="{Binding Routes}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RouteRow">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                    <TextBlock Text="{Binding Summary}" VerticalAlignment="Center"
                               Opacity="{Binding IsEnabled, Converter={x:Static conv:BoolToOpacityConverter.Instance}}" />
                    <Button Grid.Column="1" Classes="btn" Content="On / off" Width="120"
                            Command="{Binding DataContext.ToggleRouteCommand, ElementName=Root}"
                            CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Ticket options" Classes="title" Margin="0,16,0,4" />
            <TextBox Classes="field" Watermark="Encoding gbk|gb18030|utf8" Text="{Binding PrintEncoding}" />
            <CheckBox IsChecked="{Binding PrintChineseAsRaster}" Content="Print Chinese as an image (safer on cheap printers)" Foreground="#1c1917" Margin="0,4" />
            <CheckBox IsChecked="{Binding OpenDrawerOnCash}" Content="Open drawer on cash pay" Foreground="#1c1917" Margin="0,4" />
            <CheckBox IsChecked="{Binding SendKitchenOnPay}" Content="Also print kitchen on Pay if not yet sent" Foreground="#1c1917" Margin="0,4" />
            <CheckBox IsChecked="{Binding PrintFrontOnPay}" Content="Print front receipt on pay" Foreground="#1c1917" Margin="0,4" />
            <CheckBox IsChecked="{Binding PrintVoidKitchenTicket}" Content="Print VOID kitchen ticket on void" Foreground="#1c1917" Margin="0,4" />
            <TextBlock Text="Caller ID" FontWeight="SemiBold" Foreground="#c2410c" Margin="0,12,0,4" />
            <CheckBox IsChecked="{Binding CallerIdEnabled}" Content="Enable Caller ID" Foreground="#1c1917" />
            <TextBox Classes="field" Watermark="Mode: simulate | serial" Text="{Binding CallerIdMode}" />
            <TextBox Classes="field" Watermark="COM port" Text="{Binding CallerIdCom}" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
              <Button Classes="primary" Content="Test print" Command="{Binding TestPrintCommand}" Width="140" />
              <Button Classes="btn" Content="Open drawer (PIN)" Command="{Binding OpenDrawerCommand}" Width="160" Height="52" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="panel" Padding="16" IsVisible="{Binding IsStaff}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
              <TextBlock Text="Staff" Classes="title" />
              <TextBlock Text="{Binding StaffHint}" Classes="muted" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="*,160,Auto">
                <TextBox Classes="field" Watermark="Name" Text="{Binding NewStaffName}" Margin="0,0,8,0" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding StaffRoles}"
                          SelectedItem="{Binding NewStaffRole}" Height="44" Margin="0,0,8,0"
                          HorizontalAlignment="Stretch" />
                <Button Grid.Column="2" Classes="primary" Content="Add staff"
                        Command="{Binding AddStaffCommand}" Width="140" />
              </Grid>
            </StackPanel>

            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding StaffMembers}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:StaffRow">
                    <Border Classes="panel-flat" Padding="12" Margin="0,0,0,8">
                      <Grid ColumnDefinitions="*,150,Auto,Auto">
                        <StackPanel VerticalAlignment="Center">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <Border Classes="pill warn" IsVisible="{Binding NeedsAttention}">
                              <TextBlock Text="{Binding Status}" />
                            </Border>
                            <Border Classes="pill ok" IsVisible="{Binding IsCurrent}">
                              <TextBlock Text="Signed in" />
                            </Border>
                          </StackPanel>
                          <TextBlock Text="Switched off" Classes="muted"
                                     IsVisible="{Binding !IsActive}" />
                        </StackPanel>

                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding DataContext.StaffRoles, ElementName=Root}"
                                  SelectedItem="{Binding SelectedRole}" Height="44"
                                  HorizontalAlignment="Stretch" Margin="0,0,8,0" />

                        <Button Grid.Column="2" Classes="btn" Content="Save role" Width="110"
                                Margin="0,0,8,0"
                                Command="{Binding DataContext.SetStaffRoleCommand, ElementName=Root}"
                                CommandParameter="{Binding}" />

                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                          <Button Classes="btn" Content="Change PIN" Width="130"
                                  Command="{Binding DataContext.ChangeStaffPinCommand, ElementName=Root}"
                                  CommandParameter="{Binding}" />
                          <Button Classes="btn" Content="{Binding ActiveLabel}" Width="120"
                                  Command="{Binding DataContext.ToggleStaffActiveCommand, ElementName=Root}"
                                  CommandParameter="{Binding}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <Border Classes="panel" CornerRadius="8" Padding="16" IsVisible="{Binding IsShift}">
          <StackPanel Spacing="8">
            <TextBlock Text="Today summary / 今日汇总" FontWeight="Bold" FontSize="18" Foreground="#1c1917" />
            <TextBox Text="{Binding ShiftSummary}" IsReadOnly="True" AcceptsReturn="True" Classes="field" MinHeight="180" />
          </StackPanel>
        </Border>

        <Border Classes="panel" CornerRadius="8" Padding="16" IsVisible="{Binding IsNotes}">
          <StackPanel Spacing="8">
            <TextBlock Text="Quick notes / 快捷备注" FontWeight="Bold" FontSize="18" Foreground="#1c1917" />
            <Grid ColumnDefinitions="*,*,Auto,Auto">
              <TextBox Classes="field" Watermark="English" Text="{Binding NewNoteEn}" Margin="0,0,6,0" />
              <TextBox Grid.Column="1" Classes="field" Watermark="厨房中文" Text="{Binding NewNoteZh}" Margin="0,0,6,0" />
              <Button Grid.Column="2" Classes="primary" Content="Add" Command="{Binding AddNoteCommand}" Width="80" Height="40" />
            </Grid>
            <ItemsControl ItemsSource="{Binding NoteRows}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:QuickNoteEditRow">
                  <Grid ColumnDefinitions="*,*,Auto" Margin="0,4">
                    <TextBox Classes="field" Text="{Binding En}" Margin="0,0,6,0" />
                    <TextBox Grid.Column="1" Classes="field" Text="{Binding Zh}" Margin="0,0,6,0" />
                    <Button Grid.Column="2" Classes="btn" Content="Del"
                            Command="{Binding DataContext.RemoveNoteCommand, ElementName=Root}"
                            CommandParameter="{Binding}" Width="64" Height="40" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Save settings to apply notes on Till." Foreground="#5b6472" FontSize="12" />
          </StackPanel>
        </Border>

        <Border Classes="panel" CornerRadius="8" Padding="16" IsVisible="{Binding IsOnline}">
          <StackPanel Spacing="4">
            <TextBlock Text="Online (Advanced) / 线上" FontWeight="Bold" FontSize="18" Foreground="#1c1917" Margin="0,0,0,4" />
            <TextBlock Text="Copy a / u / p from website Admin → Print. Stored locally only."
                       FontSize="12" Foreground="#5b6472" TextWrapping="Wrap" Margin="0,0,0,8" />
            <TextBox Classes="field" Watermark="Base URL" Text="{Binding OnlineBaseUrl}" />
            <Button Classes="btn" Content="Apply base URL → endpoints" Command="{Binding ApplyBaseUrlCommand}"
                    HorizontalAlignment="Left" Width="260" Height="40" Margin="0,0,0,8" />
            <TextBox Classes="field" Watermark="Next URL" Text="{Binding OrderServerUrl}" />
            <TextBox Classes="field" Watermark="Ack URL" Text="{Binding PrintedUrl}" />
            <TextBox Classes="field" Watermark="Res ID (a)" Text="{Binding OnlineResId}" />
            <TextBox Classes="field" Watermark="Username (u)" Text="{Binding OnlineUsername}" />
            <TextBox Classes="field" Watermark="Password (p)" Text="{Binding OnlinePassword}" PasswordChar="•" />
            <TextBox Classes="field" Watermark="Poll interval seconds" Text="{Binding PollIntervalText}" />
            <CheckBox IsChecked="{Binding OnlinePollingEnabled}" Content="Start accepting web orders when the till starts" Foreground="#1c1917" Margin="0,4" />
            <CheckBox IsChecked="{Binding AutoKitchenPrintOnline}" Content="Print web orders to the kitchen automatically" Foreground="#1c1917" Margin="0,4" />

            <!-- Proving the credentials at install time, before the shop opens. -->
            <Button Classes="primary" Content="Test connection" Command="{Binding TestWebOrdersCommand}"
                    HorizontalAlignment="Left" Width="220" Margin="0,12,0,0" />
            <TextBlock Text="{Binding WebTestResult}" Classes="muted" TextWrapping="Wrap" Margin="0,8,0,0" />
            <TextBlock Text="Turning the feed on and off during service is the button in the top bar."
                       Classes="muted" TextWrapping="Wrap" Margin="0,8,0,0" />
          </StackPanel>
        </Border>

      </StackPanel>

      <!-- Menu operations: categories · dishes · full editor -->
      <Border Classes="panel" CornerRadius="8" Padding="12" IsVisible="{Binding IsMenu}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,10">
              <TextBlock Text="{Binding LblMenuOpsTitle}" FontWeight="Bold" FontSize="18" Foreground="#1c1917" />
              <TextBlock Text="{Binding LblMenuOpsHint}"
                         Foreground="#5b6472" FontSize="12" TextWrapping="Wrap" />
              <TextBlock Text="{Binding MenuInfo}" Foreground="#5b6472" FontSize="11" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Classes="field" Watermark="Search # / name" Text="{Binding MenuSearch}" Margin="0,0,8,0" />
                <Button Grid.Column="1" Classes="btn" Content="{Binding LblReimport}"
                        Command="{Binding ReimportMenuCommand}" MinWidth="140" Height="40" />
              </Grid>
            </StackPanel>

            <Grid ColumnDefinitions="170,210,*" MinHeight="520">
              <!-- Categories -->
              <Border Background="#f4f6f8" CornerRadius="8" Padding="8" Margin="0,0,8,0">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
                    <TextBlock Text="{Binding LblCategories}" FontWeight="SemiBold" Foreground="#c2410c" />
                    <Button Classes="primary" Content="{Binding LblAddCategory}" Command="{Binding AddCategoryCommand}" Height="40" />
                    <Grid ColumnDefinitions="*,*,*" >
                      <Button Classes="btn" Content="{Binding LblEdit}" Command="{Binding BeginEditCategoryCommand}" Height="36" Margin="0,0,4,0" />
                      <Button Grid.Column="1" Classes="btn" Content="{Binding LblHideShow}" Command="{Binding ToggleCategoryVisibleCommand}"
                              CommandParameter="{Binding SelectedMenuCategory}" Height="36" Margin="0,0,4,0" />
                      <Button Grid.Column="2" Classes="btn" Content="{Binding LblDelete}" Command="{Binding DeleteCategoryCommand}" Height="36" />
                    </Grid>
                  </StackPanel>
                  <ListBox Classes="ticket" ItemsSource="{Binding MenuCategories}" SelectedItem="{Binding SelectedMenuCategory}">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:CategoryAdminRow">
                        <StackPanel Margin="6,6">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#1c1917" TextWrapping="Wrap" FontSize="13" />
                          <TextBlock Text="{Binding VisibilityText}" FontSize="11" Foreground="#5b6472" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </DockPanel>
              </Border>

              <!-- Dishes -->
              <Border Grid.Column="1" Background="#f4f6f8" CornerRadius="8" Padding="8" Margin="0,0,8,0">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
                    <TextBlock Text="{Binding LblDishes}" FontWeight="SemiBold" Foreground="#c2410c" />
                    <Button Classes="cash" Content="{Binding LblAddDish}" Command="{Binding AddDishCommand}" Height="40" />
                  </StackPanel>
                  <ListBox Classes="ticket" ItemsSource="{Binding MenuRows}" SelectedItem="{Binding SelectedMenuItem}">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:MenuEditRow">
                        <StackPanel Margin="6,6">
                          <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="#1c1917" TextWrapping="Wrap" FontSize="13" />
                          <TextBlock FontSize="11" Foreground="#5b6472">
                            <Run Text="{Binding Item.BasePrice, StringFormat={}£{0:0.00}}" />
                            <Run Text=" · " />
                            <Run Text="{Binding StatusText}" />
                            <Run Text=" · " />
                            <Run Text="{Binding OptionsBadge}" />
                          </TextBlock>
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </DockPanel>
              </Border>

              <!-- Editor pane -->
              <Border Grid.Column="2" Background="#f4f6f8" CornerRadius="8" Padding="12">
                <Panel>
                  <!-- Category editor -->
                  <StackPanel IsVisible="{Binding EditingCategory}" Spacing="8" MaxWidth="420">
                    <TextBlock Text="Edit category" FontWeight="Bold" FontSize="16" Foreground="#1c1917" />
                    <TextBox Classes="field" Watermark="Name" Text="{Binding CategoryEditName}" />
                    <TextBox Classes="field" Watermark="Sort order" Text="{Binding CategoryEditSort}" />
                    <CheckBox IsChecked="{Binding CategoryEditVisible}" Content="Visible on the till" Foreground="#1c1917" />
                    <Button Classes="cash" Content="Save category" Command="{Binding SaveCategoryCommand}" Width="180" />
                  </StackPanel>

                  <!-- Dish editor -->
                  <DockPanel IsVisible="{Binding HasDishEditor}">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                      <Button Classes="cash" Content="{Binding LblSaveDish}" Command="{Binding SaveDishCommand}" Width="130" Height="48" />
                      <Button Classes="btn" Content="{Binding LblDuplicate}" Command="{Binding DuplicateDishCommand}" Width="100" Height="48" />
                      <Button Classes="btn" Content="{Binding Lbl86}" Command="{Binding Toggle86CurrentCommand}" Width="72" Height="48" />
                      <Button Classes="danger" Content="{Binding LblDelete}" Command="{Binding DeleteDishCommand}" Width="90" Height="48" />
                    </StackPanel>
                    <ScrollViewer>
                      <StackPanel Spacing="8" Margin="0,0,8,0">
                        <TextBlock Text="{Binding LblDishEditor}" FontWeight="Bold" FontSize="16" Foreground="#1c1917" />
                        <TextBlock Text="{Binding DishEditor.ValidationMessage}" Foreground="#b91c1c" TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="*,*">
                          <TextBox Classes="field" Watermark="Menu # (e.g. 54)" Text="{Binding DishEditor.MenuNumber}" Margin="0,0,6,0" />
                          <ComboBox Grid.Column="1" ItemsSource="{Binding DishEditor.Categories}"
                                    SelectedItem="{Binding DishEditor.SelectedCategory}"
                                    PlaceholderText="Category" Height="34" />
                        </Grid>
                        <TextBox Classes="field" Watermark="Front name (English)" Text="{Binding DishEditor.Name}" />
                        <TextBox Classes="field" Watermark="Kitchen name (中文 · print)" Text="{Binding DishEditor.KitchenName}" />
                        <Grid ColumnDefinitions="*,80">
                          <TextBox Classes="field" Watermark="Price £" Text="{Binding DishEditor.PriceText}" Margin="0,0,6,0" />
                          <TextBox Grid.Column="1" Classes="field" Watermark="Sort" Text="{Binding DishEditor.SortOrderText}" />
                        </Grid>
                        <CheckBox IsChecked="{Binding DishEditor.IsAvailable}" Content="On sale (uncheck = 86)" Foreground="#1c1917" />
                        <TextBox Classes="field" Watermark="Description / staff hint" Text="{Binding DishEditor.Description}" />

                        <Grid ColumnDefinitions="*,Auto" Margin="0,12,0,4">
                          <TextBlock Text="{Binding LblOptionGroups}" FontWeight="Bold" Foreground="#c2410c" VerticalAlignment="Center" />
                          <Button Grid.Column="1" Classes="btn" Content="{Binding LblAddGroup}" Command="{Binding AddOptionGroupCommand}"
                                  MinWidth="90" Height="36" />
                        </Grid>
                        <TextBlock Text="Single = pick one · Multi = checkbox with min/max · Conditional = show when another choice picked"
                                   Foreground="#5b6472" FontSize="11" TextWrapping="Wrap" />

                        <ItemsControl ItemsSource="{Binding DishEditor.Groups}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:OptionGroupEditorVm">
                              <Border Background="#ffffff" CornerRadius="8" Padding="10" Margin="0,0,0,10"
                                      BorderBrush="#d0d5dd" BorderThickness="1">
                                <StackPanel Spacing="6">
                                  <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Classes="field" Text="{Binding Name}" Watermark="Group name" Margin="0,0,6,0" />
                                    <Button Grid.Column="1" Classes="btn" Content="{Binding DataContext.LblRemove, ElementName=Root}"
                                            Command="{Binding DataContext.RemoveOptionGroupCommand, ElementName=Root}"
                                            CommandParameter="{Binding}" Width="80" Height="34" FontSize="11" Margin="0" />
                                  </Grid>
                                  <Grid ColumnDefinitions="*,Auto,70,70">
                                    <ComboBox ItemsSource="{Binding DataContext.OptionTypeChoices, ElementName=Root}"
                                              SelectedItem="{Binding SelectedType}" Height="34" Margin="0,0,6,0" />
                                    <CheckBox Grid.Column="1" IsChecked="{Binding Required}"
                                              Content="{Binding DataContext.LblRequired, ElementName=Root}"
                                              Foreground="#1c1917" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox Grid.Column="2" Classes="field" Text="{Binding MinText}" Watermark="Min"
                                             IsVisible="{Binding IsMulti}" Margin="0,0,4,0" />
                                    <TextBox Grid.Column="3" Classes="field" Text="{Binding MaxText}" Watermark="Max"
                                             IsVisible="{Binding IsMulti}" />
                                  </Grid>
                                  <TextBlock Text="Show when (conditional)" FontSize="11" Foreground="#5b6472" />
                                  <ComboBox ItemsSource="{Binding ParentGroupOptions}" SelectedItem="{Binding SelectedShowWhen}"
                                            Height="34" />
                                  <Button Classes="btn" Content="Refresh conditional list" Command="{Binding DataContext.RefreshShowWhenCommand, ElementName=Root}"
                                          Height="32" HorizontalAlignment="Left" Width="180" FontSize="11" />

                                  <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding DataContext.LblChoices, ElementName=Root}" FontWeight="SemiBold" Foreground="#c2410c" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Classes="btn" Content="{Binding DataContext.LblAddChoice, ElementName=Root}"
                                            Command="{Binding DataContext.AddChoiceCommand, ElementName=Root}"
                                            CommandParameter="{Binding}" MinWidth="90" Height="32" FontSize="11" />
                                  </Grid>
                                  <ItemsControl ItemsSource="{Binding Choices}">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate x:DataType="vm:OptionChoiceEditorVm">
                                        <Border Classes="panel" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                                          <StackPanel Spacing="4">
                                            <Grid ColumnDefinitions="*,*,56,Auto">
                                              <TextBox Classes="field" Text="{Binding Label}" Watermark="Label" Margin="0,0,4,0" />
                                              <TextBox Grid.Column="1" Classes="field" Text="{Binding KitchenName}" Watermark="中文" Margin="0,0,4,0" />
                                              <TextBox Grid.Column="2" Classes="field" Text="{Binding PriceDeltaText}" Watermark="+£ / 0" Margin="0,0,4,0" />
                                              <Button Grid.Column="3" Classes="btn" Content="×"
                                                      Command="{Binding DataContext.RemoveChoiceCommand, ElementName=Root}"
                                                      CommandParameter="{Binding}" Width="36" Height="32" Margin="0" />
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                              <CheckBox IsChecked="{Binding IsDefault}" Content="Default" Foreground="#5b6472" />
                                              <CheckBox IsChecked="{Binding IsAvailable}" Content="Available" Foreground="#5b6472" />
                                            </StackPanel>
                                          </StackPanel>
                                        </Border>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </ScrollViewer>
                  </DockPanel>

                  <TextBlock Text="Select a category/dish, or create new." Foreground="#5b6472"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             IsVisible="{Binding ShowEmptyEditorHint}" />
                </Panel>
              </Border>
            </Grid>
          </DockPanel>
      </Border>
      </Panel>
    </ScrollViewer>
  </Grid>
</UserControl>
