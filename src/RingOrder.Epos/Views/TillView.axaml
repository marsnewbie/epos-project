<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RingOrder.Epos.ViewModels"
             xmlns:domain="using:RingOrder.Epos.Domain"
             xmlns:conv="using:RingOrder.Epos.Converters"
             x:Class="RingOrder.Epos.Views.TillView"
             x:Name="Root"
             x:DataType="vm:TillViewModel"
             Background="{StaticResource Page}">

  <Grid>
  <Grid ColumnDefinitions="176,*,430"
        IsEnabled="{Binding !ShowChangeOverlay}"
        IsVisible="{Binding !ShowCashPanel}">

    <!-- Categories -->
    <Border Grid.Column="0" Classes="panel" Padding="8" Margin="0,0,8,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
          <TextBox Classes="field" Watermark="{Binding WmSearch}"
                   Text="{Binding SearchText}" />
          <Grid ColumnDefinitions="*,62">
            <TextBox Classes="field" Watermark="{Binding WmDishNumber}"
                     Text="{Binding DishNumberText}" Margin="0,0,4,0" />
            <Button Grid.Column="1" Classes="btn" Content="{Binding LblAdd}"
                    Command="{Binding AddByDishNumberCommand}" Margin="0" />
          </Grid>
          <Button Classes="btn" Content="{Binding LblPhoneOrder}"
                  Command="{Binding StartPhoneOrderCommand}"
                  HorizontalAlignment="Stretch" />
        </StackPanel>
        <Button DockPanel.Dock="Bottom" Classes="btn" Content="{Binding LblAdHoc}"
                Command="{Binding ToggleAdHocCommand}" Margin="0,8,0,0"
                HorizontalAlignment="Stretch" />
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding CategoryTiles}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CategoryTile">
                <Button Classes="category" Classes.on="{Binding IsSelected}"
                        Content="{Binding Name}" Margin="0,0,0,4"
                        HorizontalAlignment="Stretch"
                        Command="{Binding #Root.((vm:TillViewModel)DataContext).SelectCategoryCommand}"
                        CommandParameter="{Binding Category}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Menu grid -->
    <Grid Grid.Column="1" Margin="0,0,8,0">
      <DockPanel>
        <Border DockPanel.Dock="Top" Padding="4,0,4,8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding CategoryHeading}" Classes="title" />
            <TextBlock Grid.Column="1" Text="{Binding PanelStatus}" Foreground="#c2410c" FontSize="12"
                       VerticalAlignment="Center" MaxWidth="280" TextTrimming="CharacterEllipsis" />
          </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Classes="panel" Padding="8" Margin="0,8,0,0"
                IsVisible="{Binding ShowAdHoc}">
          <Grid ColumnDefinitions="*,80,80,88">
            <TextBox Classes="field" Watermark="{Binding WmAdHocName}" Text="{Binding AdHocName}" Margin="0,0,6,0" />
            <TextBox Grid.Column="1" Classes="field" Watermark="£" Text="{Binding AdHocPrice}" Margin="0,0,6,0" />
            <TextBox Grid.Column="2" Classes="field" Watermark="中文" Text="{Binding AdHocZh}" Margin="0,0,6,0" />
            <Button Grid.Column="3" Classes="primary" Content="{Binding LblAdd}"
                    Command="{Binding AddAdHocCommand}" Height="40" />
          </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Classes="panel" Padding="8" Margin="0,8,0,0">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" MaxHeight="64">
            <ItemsControl ItemsSource="{Binding QuickNotes}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:QuickNoteItem">
                  <Button Classes="chip" Content="{Binding ChipLabel}"
                          Command="{Binding #Root.((vm:TillViewModel)DataContext).ApplyQuickNoteCommand}"
                          CommandParameter="{Binding}" ToolTip.Tip="{Binding Display}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>

        <!--
          Paging bar, not a scrollbar. Page 2 of Chicken is always page 2 of
          Chicken; a scroll position is wherever the last person left it.
        -->
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,Auto,Auto,*"
              Margin="0,8,0,0" IsVisible="{Binding HasPages}">
          <Button Classes="btn" Content="▲" Width="72"
                  Command="{Binding PreviousPageCommand}" Margin="0,0,6,0" />
          <Button Grid.Column="1" Classes="btn" Content="▼" Width="72"
                  Command="{Binding NextPageCommand}" Margin="0,0,10,0" />
          <TextBlock Grid.Column="2" Text="{Binding PageLabel}" Classes="muted"
                     VerticalAlignment="Center" />
        </Grid>

        <!--
          Fixed 5-column grid: a dish keeps its place whatever else changes, so
          staff stop reading the tiles and start hitting them from memory.
        -->
        <ItemsControl ItemsSource="{Binding Items}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="5" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="domain:MenuItem">
              <Button Classes="dish" Classes.out="{Binding !IsAvailable}" Margin="0,0,6,6"
                      HorizontalAlignment="Stretch"
                      Command="{Binding #Root.((vm:TillViewModel)DataContext).SelectItemCommand}"
                      CommandParameter="{Binding}">
                <DockPanel>
                  <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding MenuNumber}" FontSize="{StaticResource FontStrong}"
                               FontWeight="Bold" Foreground="{StaticResource Accent}" />
                    <Border Grid.Column="1" Classes="pill bad" Padding="6,1"
                            IsVisible="{Binding !IsAvailable}">
                      <TextBlock Text="86" />
                    </Border>
                  </Grid>
                  <TextBlock DockPanel.Dock="Bottom"
                             Text="{Binding BasePrice, StringFormat={}£{0:0.00}}"
                             FontSize="{StaticResource FontSmall}" FontWeight="SemiBold"
                             Foreground="{StaticResource InkMuted}" />
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap"
                               FontSize="{StaticResource FontSmall}" FontWeight="SemiBold"
                               MaxHeight="36" />
                    <TextBlock Text="{Binding ItemTranslation}" TextWrapping="Wrap"
                               FontSize="{StaticResource FontCaption}"
                               Foreground="{StaticResource InkMuted}" MaxHeight="18" />
                  </StackPanel>
                </DockPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DockPanel>

      <Border IsVisible="{Binding ShowModifierPanel}" Background="#99000000" CornerRadius="8" ZIndex="10">
        <Border Background="#ffffff" BorderBrush="#ea580c" BorderThickness="2" CornerRadius="12"
                Margin="20" Padding="0" MaxWidth="720" MaxHeight="640"
                HorizontalAlignment="Center" VerticalAlignment="Center">
          <DockPanel>
            <Border DockPanel.Dock="Top" Background="#fff7ed" Padding="16,12" CornerRadius="12,12,0,0">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="{Binding ModifierTitle}" FontSize="20" FontWeight="Bold"
                             Foreground="#1c1917" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding ModifierHint}" Foreground="#5b6472" FontSize="12"
                             TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                  <TextBlock Text="{Binding ModifierPriceText}" FontSize="22" FontWeight="Bold"
                             Foreground="#c2410c" HorizontalAlignment="Right" />
                </StackPanel>
              </Grid>
            </Border>
            <Border DockPanel.Dock="Bottom" Padding="12" Background="#f4f6f8" CornerRadius="0,0,12,12">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding ModifierError}" Foreground="#b91c1c" FontSize="13"
                           TextWrapping="Wrap" />
                <TextBox Classes="field" Watermark="{Binding WmOrderNotes}" Text="{Binding LineNotesDraft}" Margin="0" />
                <Grid ColumnDefinitions="*,2*">
                  <Button Classes="btn" Content="{Binding LblCancel}" Command="{Binding CancelModifierCommand}"
                          Height="52" Margin="0,0,8,0" />
                  <Button Grid.Column="1" Classes="cash" Content="{Binding LblAddToTicket}"
                          Command="{Binding AddSelectedItemCommand}" Height="52" />
                </Grid>
              </StackPanel>
            </Border>
            <ScrollViewer Padding="14,10" MaxHeight="420">
              <ItemsControl ItemsSource="{Binding ModifierGroups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ModifierGroupVm">
                    <Border Background="#f8fafc" CornerRadius="8" Padding="12" Margin="0,0,0,10"
                            BorderBrush="#d0d5dd" BorderThickness="1">
                      <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" Foreground="#1c1917" />
                          <Border Background="#e8eaed" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TypeLabel}" FontSize="10" FontWeight="SemiBold" Foreground="#c2410c" />
                          </Border>
                          <Border Background="#fee2e2" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                  IsVisible="{Binding IsRequired}">
                            <TextBlock Text="{Binding #Root.((vm:TillViewModel)DataContext).LblRequired}" FontSize="10"
                                       FontWeight="Bold" Foreground="#b91c1c" />
                          </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding ConditionalNote}" Foreground="#c2410c" FontSize="11"
                                   IsVisible="{Binding IsConditional}" />
                        <TextBlock Text="{Binding Hint}" Foreground="#5b6472" FontSize="12" />
                        <ItemsControl ItemsSource="{Binding Choices}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ModifierChoiceVm">
                              <Button Classes="option" Classes.on="{Binding IsSelected}" Classes.multi="{Binding IsMulti}"
                                      IsEnabled="{Binding IsEnabled}" Margin="0,0,8,8" MinWidth="140" MaxWidth="220"
                                      Command="{Binding #Root.((vm:TillViewModel)DataContext).ToggleOptionCommand}"
                                      CommandParameter="{Binding}">
                                <Grid ColumnDefinitions="22,*" Margin="2,0">
                                  <TextBlock Text="{Binding Glyph}" FontSize="16" VerticalAlignment="Center"
                                             Foreground="#c2410c" />
                                  <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="13"
                                               TextWrapping="Wrap" Foreground="#1c1917" />
                                    <Grid ColumnDefinitions="*,Auto">
                                      <TextBlock Text="{Binding Translation}" FontSize="11" Foreground="#5b6472"
                                                 TextTrimming="CharacterEllipsis" />
                                      <TextBlock Grid.Column="1" Text="{Binding PriceDeltaText}" FontSize="11"
                                                 FontWeight="Bold" Foreground="#c2410c" Margin="6,0,0,0" />
                                    </Grid>
                                  </StackPanel>
                                </Grid>
                              </Button>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Border>
    </Grid>

    <!-- Ticket column -->
    <Border Grid.Column="2" Classes="panel" Padding="0" ClipToBounds="True">
      <Grid>
        <DockPanel Margin="10">

          <Border DockPanel.Dock="Top" Background="#fff7ed" CornerRadius="8" Padding="10,8" Margin="0,0,0,8"
                  BorderBrush="#fdba74" BorderThickness="1">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="{Binding TicketNumberText}" FontSize="18" FontWeight="Bold" Foreground="#1c1917" />
                <Border Background="#c2410c" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                  <TextBlock Text="{Binding TicketStatusBadge}" FontWeight="Bold" FontSize="11" Foreground="#fff7ed" />
                </Border>
              </StackPanel>
              <Button Grid.Column="1" Classes="btn" Content="{Binding HeldButtonText}"
                      Command="{Binding ToggleHeldPanelCommand}" MinWidth="78" Height="36" Margin="0,0,4,0" FontSize="12" />
              <Button Grid.Column="2" Classes="btn" Content="{Binding LblNew}"
                      Command="{Binding NewTicketCommand}" Width="64" Height="36" Margin="0,0,4,0" FontSize="12" />
              <Button Grid.Column="3" Classes="btn" Content="{Binding LblClear}"
                      Command="{Binding ClearTicketCommand}" Width="64" Height="36" FontSize="12" />
            </Grid>
          </Border>

          <Border DockPanel.Dock="Top" Background="#f4f6f8" CornerRadius="8" Padding="8" Margin="0,0,0,8"
                  IsVisible="{Binding ShowHeldPanel}" BorderBrush="#d0d5dd" BorderThickness="1">
            <ItemsControl ItemsSource="{Binding HeldOrders}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="domain:PosOrder">
                  <Button Classes="chip" Margin="0,0,6,4" HorizontalAlignment="Left"
                          Command="{Binding #Root.((vm:TillViewModel)DataContext).ResumeHeldCommand}"
                          CommandParameter="{Binding}">
                    <TextBlock FontSize="12">
                      <Run Text="{Binding HoldLabel}" />
                      <Run Text=" " />
                      <Run Text="{Binding Total, StringFormat={}£{0:0.00}}" />
                    </TextBlock>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>

          <UniformGrid DockPanel.Dock="Top" Columns="4" Margin="0,0,0,6">
            <Button Classes="btn" Classes.on="{Binding IsCollection}" Content="{Binding LblTypeCollection}"
                    Command="{Binding SetOrderTypeCommand}" CommandParameter="Collection" Margin="0,0,4,0" />
            <Button Classes="btn" Classes.on="{Binding IsDelivery}" Content="{Binding LblTypeDelivery}"
                    Command="{Binding SetOrderTypeCommand}" CommandParameter="Delivery" Margin="0,0,4,0" />
            <Button Classes="btn" Classes.on="{Binding IsWalkIn}" Content="{Binding LblTypeWaiting}"
                    Command="{Binding SetOrderTypeCommand}" CommandParameter="WalkIn" Margin="0,0,4,0" />
            <Button Classes="btn" Classes.on="{Binding IsEatIn}" Content="{Binding LblTypeTable}"
                    Command="{Binding SetOrderTypeCommand}" CommandParameter="EatIn" />
          </UniformGrid>

          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <Grid ColumnDefinitions="*,*">
              <TextBox Classes="field" Watermark="{Binding WmName}" Text="{Binding CustomerName}" Margin="0,0,4,4" />
              <TextBox Grid.Column="1" Classes="field" Watermark="{Binding WmPhone}" Text="{Binding CustomerPhone}" Margin="0,0,0,4" />
            </Grid>
            <!-- Postcode first, then Find, then the street: the order a UK
                 delivery is actually established over the phone. -->
            <StackPanel IsVisible="{Binding IsDelivery}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Classes="field" Watermark="{Binding WmPostcode}" Text="{Binding DeliveryPostcode}" />
                <Button Grid.Column="1" Classes="card" Width="84" Margin="4,0,0,0"
                        Content="{Binding AddressLookup.LblFind}"
                        Command="{Binding AddressLookup.FindCommand}"
                        IsEnabled="{Binding !AddressLookup.IsBusy}" />
              </Grid>
              <TextBox Classes="field" Watermark="{Binding WmAddress}" Text="{Binding DeliveryAddress}" />

              <!--
                What the postcode costs to deliver to, stated where it is typed.
                Amber when staff need to do something about it — outside the area,
                or under a minimum — rather than a colour that means nothing.
              -->
              <Panel Margin="0,4,0,0" IsVisible="{Binding HasDeliveryZoneNote}">
                <Border CornerRadius="6" Padding="8,5" BorderThickness="1"
                        Background="#f4f6f8" BorderBrush="#d0d5dd"
                        IsVisible="{Binding !DeliveryNeedsAttention}">
                  <TextBlock Text="{Binding DeliveryZoneNote}" FontSize="11" TextWrapping="Wrap"
                             Foreground="#5b6472" />
                </Border>
                <Border CornerRadius="6" Padding="8,5" BorderThickness="1"
                        Background="#fff7ed" BorderBrush="#fdba74"
                        IsVisible="{Binding DeliveryNeedsAttention}">
                  <TextBlock Text="{Binding DeliveryZoneNote}" FontSize="11" TextWrapping="Wrap"
                             Foreground="#9a3412" FontWeight="SemiBold" />
                </Border>
              </Panel>

              <StackPanel DataContext="{Binding AddressLookup}">
                <TextBlock Text="{Binding Status}" Classes="muted" FontSize="11" TextWrapping="Wrap"
                           Margin="2,3,0,0" IsVisible="{Binding HasStatus}" />
                <ListBox IsVisible="{Binding HasCandidates}" ItemsSource="{Binding Candidates}"
                         SelectedItem="{Binding SelectedCandidate}"
                         Background="#ffffff" BorderBrush="#d0d5dd" BorderThickness="1"
                         CornerRadius="6" Margin="0,4,0,0" MaxHeight="176">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Display}" FontSize="13" TextWrapping="Wrap"
                                 MinHeight="30" VerticalAlignment="Center" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </StackPanel>

            <TextBox Classes="field" Watermark="{Binding WmTable}" Text="{Binding TableNumber}"
                     IsVisible="{Binding IsEatIn}" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding CustomerSummary}" Classes="muted" FontSize="11"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                         IsVisible="{Binding !ShowCustomerMore}" />
              <Button Grid.Column="1" Classes="btn" Content="{Binding LblNotes}"
                      Command="{Binding ToggleCustomerMoreCommand}" Width="72" Height="28" FontSize="11" Margin="0" />
            </Grid>
            <TextBox Classes="field" Watermark="{Binding WmOrderNotes}" Text="{Binding OrderNotes}"
                     IsVisible="{Binding ShowCustomerMore}" />
          </StackPanel>

          <Border DockPanel.Dock="Bottom" Classes="panel-flat" Margin="0,8,0,0">
            <StackPanel Spacing="8">

              <!-- Discount stays on screen while it applies, with one tap to undo. -->
              <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasDiscount}">
                <Border Classes="pill warn" HorizontalAlignment="Left">
                  <TextBlock Text="{Binding DiscountText}" />
                </Border>
                <Button Grid.Column="1" Classes="btn" Content="✕" Width="48" MinHeight="36" Height="36"
                        Command="{Binding ClearDiscountCommand}" />
              </Grid>

              <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="4" IsEnabled="{Binding CanEditSelectedLine}">
                  <Button Classes="key" Content="−" Command="{Binding QtyMinusCommand}" Width="44" Margin="0,0,4,0" />
                  <Button Classes="key" Content="+" Command="{Binding QtyPlusCommand}" Width="44" Margin="0,0,4,0" />
                  <Button Classes="key" Content="⌫" Command="{Binding RemoveLineCommand}" Width="44" Margin="0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding ItemsCountText}" Classes="muted" FontSize="12" />
                  <TextBlock Text="{Binding PaymentSummaryText}" FontSize="11" Foreground="#c2410c"
                             IsVisible="{Binding HasPayments}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                  <TextBlock Text="{Binding Total, StringFormat={}£{0:0.00}}"
                             FontSize="26" FontWeight="Bold" Foreground="#1c1917" HorizontalAlignment="Right" />
                  <TextBlock Text="{Binding DeliveryFee, StringFormat=+ £{0:0.00}}"
                             Classes="muted" FontSize="11" HorizontalAlignment="Right"
                             IsVisible="{Binding IsDelivery}" />
                  <!-- Money added to reach a minimum is never a silent line. -->
                  <TextBlock Text="{Binding BelowMinimumSurcharge, StringFormat=+ £{0:0.00} min.}"
                             FontSize="11" Foreground="#b45309" HorizontalAlignment="Right"
                             IsVisible="{Binding HasBelowMinimumSurcharge}" />
                  <TextBlock HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="#b45309"
                             IsVisible="{Binding HasPayments}">
                    <Run Text="{Binding DueLabel}" />
                    <Run Text=" " />
                    <Run Text="{Binding BalanceDueText}" />
                  </TextBlock>
                </StackPanel>
              </Grid>

              <!--
                Function bar: the things staff reach for mid-order. They live
                here rather than in a menu because each one is needed while a
                customer is standing there.
              -->
              <UniformGrid Columns="4">
                <Button Classes="btn" Content="{Binding LblDiscount}"
                        Command="{Binding ApplyDiscountCommand}" Margin="0,0,4,0" />
                <Button Classes="btn" Content="{Binding LblNotes}"
                        Command="{Binding ToggleCustomerMoreCommand}" Margin="0,0,4,0" />
                <Button Classes="btn" Content="{Binding LblAdHoc}"
                        Command="{Binding ToggleAdHocCommand}" Margin="0,0,4,0" />
                <Button Classes="btn" Content="{Binding LblUndo}"
                        Command="{Binding RemoveLineCommand}" />
              </UniformGrid>

              <Button Classes="primary" Content="{Binding SendButtonText}"
                      Command="{Binding SendKitchenCommand}" />
              <Grid ColumnDefinitions="*,*,*">
                <Button Grid.Column="0" Classes="hold" Content="{Binding LblHold}"
                        Command="{Binding HoldTicketCommand}" Margin="0,0,4,0" Height="60" />
                <Button Grid.Column="1" Classes="cash" Content="{Binding LblPayCash}"
                        Command="{Binding BeginCashPayCommand}" Margin="0,0,4,0" Height="60" />
                <Button Grid.Column="2" Classes="card" Content="{Binding LblPayCard}"
                        Command="{Binding PayCardCommand}" Height="60" />
              </Grid>
            </StackPanel>
          </Border>

          <Grid>
            <ListBox Classes="ticket" ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}"
                     IsVisible="{Binding !IsTicketEmpty}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="domain:CartLine">
                  <Border Padding="10,8" Opacity="{Binding KitchenSent, Converter={x:Static conv:BoolToOpacityConverter.Instance}}">
                    <Grid ColumnDefinitions="44,*,72">
                      <Border Background="#fff7ed" CornerRadius="6" Width="40" Height="40"
                              VerticalAlignment="Top" HorizontalAlignment="Left"
                              BorderBrush="#fdba74" BorderThickness="1">
                        <TextBlock Text="{Binding Quantity}" FontWeight="Bold" FontSize="18" Foreground="#c2410c"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <StackPanel Grid.Column="1" Margin="10,0,8,0">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="{Binding Name}" TextWrapping="Wrap" Foreground="#1c1917"
                                     FontWeight="SemiBold" FontSize="14" />
                          <Border Grid.Column="1" Background="#ffedd5" CornerRadius="3" Padding="6,2"
                                  Margin="6,0,0,0" VerticalAlignment="Top"
                                  IsVisible="{Binding KitchenSent}">
                            <TextBlock Text="{Binding #Root.((vm:TillViewModel)DataContext).LblLineSent}"
                                       FontSize="9" FontWeight="Bold" Foreground="#c2410c" />
                          </Border>
                        </Grid>
                        <TextBlock Text="{Binding ItemTranslation}" Foreground="#5b6472" FontSize="12"
                                   IsVisible="{Binding HasTranslation}" />
                        <TextBlock Text="{Binding OptionsSummary}" TextWrapping="Wrap" Foreground="#6b7280"
                                   FontSize="11" Margin="0,2,0,0" IsVisible="{Binding HasExtras}" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding LineTotal, StringFormat={}£{0:0.00}}"
                                 FontWeight="Bold" FontSize="15" Foreground="#1c1917"
                                 HorizontalAlignment="Right" VerticalAlignment="Top" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel IsVisible="{Binding IsTicketEmpty}" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Opacity="0.7" Margin="20">
              <TextBlock Text="{Binding LblTicket}" FontSize="13" FontWeight="Bold" Foreground="#9aa3b2"
                         HorizontalAlignment="Center" LetterSpacing="2" />
              <TextBlock Text="{Binding EmptyTicketHint}" FontSize="14" Foreground="#5b6472"
                         HorizontalAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
          </Grid>
        </DockPanel>
      </Grid>
    </Border>
  </Grid>

  <!--
    Taking money gets the whole screen. It is the action with the highest cost
    of a mistake, and it was previously a 48px keypad in a 430px column.
    The ticket is not shown here on purpose: at this point the dishes are
    settled and the only questions are how much and by what.
  -->
  <Border IsVisible="{Binding ShowCashPanel}" Background="{StaticResource Page}">
    <DockPanel Margin="8">

      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <TextBlock Text="{Binding LblTakePayment}" Classes="title" />
          <Border Classes="pill accent">
            <TextBlock Text="{Binding TicketNumberText}" />
          </Border>
        </StackPanel>
        <Button Grid.Column="1" Classes="btn" Content="{Binding LblBack}"
                Command="{Binding CancelCashPayCommand}" Width="140" />
      </Grid>

      <!-- What is owed, and what has been taken so far -->
      <Border DockPanel.Dock="Left" Classes="panel" Width="420" Padding="20" Margin="0,0,10,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="4">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding LblOrderTotal}" Classes="muted" />
              <TextBlock Grid.Column="1" Text="{Binding Total, StringFormat={}£{0:0.00}}"
                         FontSize="{StaticResource FontStrong}" FontWeight="SemiBold" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasPayments}">
              <TextBlock Text="{Binding PaidLabel}" Classes="muted" />
              <TextBlock Grid.Column="1" Text="{Binding AmountPaid, StringFormat={}£{0:0.00}}"
                         FontSize="{StaticResource FontStrong}" Foreground="{StaticResource Cash}" />
            </Grid>

            <Border Height="1" Background="{StaticResource Line}" Margin="0,10" />

            <TextBlock Text="{Binding DueLabel}" Classes="muted" />
            <TextBlock Text="{Binding BalanceDueText}" FontSize="{StaticResource FontMoneyBig}"
                       FontWeight="Bold" Foreground="{StaticResource Accent}" />
          </StackPanel>

          <StackPanel DockPanel.Dock="Bottom" Spacing="4" IsVisible="{Binding HasPayments}">
            <TextBlock Text="{Binding LblTakenSoFar}" Classes="muted" />
            <TextBlock Text="{Binding PaymentSummaryText}" TextWrapping="Wrap"
                       Foreground="{StaticResource InkMuted}"
                       FontSize="{StaticResource FontSmall}" />
          </StackPanel>

          <StackPanel Margin="0,24,0,0" Spacing="4">
            <TextBlock Text="{Binding LblCashTender}" Classes="muted" />
            <TextBlock Text="{Binding CashTenderedText, StringFormat={}£{0}}"
                       FontSize="{StaticResource FontMoneyBig}" FontWeight="Bold"
                       Foreground="{StaticResource Cash}" />
            <TextBlock Text="{Binding ChangeText}" Foreground="{StaticResource Hold}"
                       FontWeight="Bold" FontSize="{StaticResource FontMoney}" Margin="0,8,0,0" />
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- How it is being paid -->
      <Border Classes="panel" Padding="16">
        <DockPanel>
          <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,*" Margin="0,12,0,0">
            <Button Classes="btn" Content="{Binding LblPrintInterim}" Width="180"
                    Command="{Binding PrintInterimReceiptCommand}"
                    IsVisible="{Binding HasPayments}" Margin="0,0,8,0" />
            <Button Grid.Column="1" Classes="card" Content="{Binding LblPayCardOnPad}"
                    Command="{Binding PayCardCommand}" Margin="0,0,8,0" />
            <Button Grid.Column="2" Classes="cash" Content="{Binding LblConfirmCash}"
                    Command="{Binding PayCashCommand}" />
          </Grid>

          <!--
            Digits on the left in phone order, notes down the right. The note
            column is where a hand goes for the commonest case by far — the
            customer hands over a twenty — so it is never more than one press
            away from the confirm button.
          -->
          <Grid RowDefinitions="*,*,*,*,*" ColumnDefinitions="*,*,*,*">
            <Button Grid.Row="0" Grid.Column="0" Classes="key" Content="7"
                    Command="{Binding CashDigitCommand}" CommandParameter="7" />
            <Button Grid.Row="0" Grid.Column="1" Classes="key" Content="8"
                    Command="{Binding CashDigitCommand}" CommandParameter="8" />
            <Button Grid.Row="0" Grid.Column="2" Classes="key" Content="9"
                    Command="{Binding CashDigitCommand}" CommandParameter="9" />
            <Button Grid.Row="0" Grid.Column="3" Classes="key tender" Content="£5"
                    Command="{Binding CashQuickCommand}" CommandParameter="5" />

            <Button Grid.Row="1" Grid.Column="0" Classes="key" Content="4"
                    Command="{Binding CashDigitCommand}" CommandParameter="4" />
            <Button Grid.Row="1" Grid.Column="1" Classes="key" Content="5"
                    Command="{Binding CashDigitCommand}" CommandParameter="5" />
            <Button Grid.Row="1" Grid.Column="2" Classes="key" Content="6"
                    Command="{Binding CashDigitCommand}" CommandParameter="6" />
            <Button Grid.Row="1" Grid.Column="3" Classes="key tender" Content="£10"
                    Command="{Binding CashQuickCommand}" CommandParameter="10" />

            <Button Grid.Row="2" Grid.Column="0" Classes="key" Content="1"
                    Command="{Binding CashDigitCommand}" CommandParameter="1" />
            <Button Grid.Row="2" Grid.Column="1" Classes="key" Content="2"
                    Command="{Binding CashDigitCommand}" CommandParameter="2" />
            <Button Grid.Row="2" Grid.Column="2" Classes="key" Content="3"
                    Command="{Binding CashDigitCommand}" CommandParameter="3" />
            <Button Grid.Row="2" Grid.Column="3" Classes="key tender" Content="£20"
                    Command="{Binding CashQuickCommand}" CommandParameter="20" />

            <Button Grid.Row="3" Grid.Column="0" Classes="key" Content="0"
                    Command="{Binding CashDigitCommand}" CommandParameter="0" />
            <Button Grid.Row="3" Grid.Column="1" Classes="key" Content="."
                    Command="{Binding CashDigitCommand}" CommandParameter="." />
            <Button Grid.Row="3" Grid.Column="2" Classes="key" Content="⌫"
                    Command="{Binding CashBackspaceCommand}" />
            <Button Grid.Row="3" Grid.Column="3" Classes="key tender" Content="£50"
                    Command="{Binding CashQuickCommand}" CommandParameter="50" />

            <Button Grid.Row="4" Grid.Column="0" Classes="key" Content="{Binding LblClearCash}"
                    Command="{Binding CashClearCommand}" />
            <Button Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Classes="key tender"
                    Content="{Binding LblExactAmount}" Command="{Binding CashExactCommand}" />
          </Grid>
        </DockPanel>
      </Border>
    </DockPanel>
  </Border>

  <!-- Full-screen settlement: must acknowledge before any till work continues -->
  <Border IsVisible="{Binding ShowChangeOverlay}" Background="#E0202531" ZIndex="100">
    <Border Background="{StaticResource Panel}" CornerRadius="12" Padding="36" Margin="24"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            BorderBrush="{StaticResource Cash}" BorderThickness="3"
            MinWidth="420" MaxWidth="560">
      <StackPanel Spacing="14">
        <!--
          The change figure stays up until someone dismisses it. An amount that
          clears itself is how the wrong money gets handed over.
        -->
        <TextBlock Text="{Binding ChangeOverlayText}" FontSize="{StaticResource FontMoneyBig}"
                   FontWeight="Bold" Foreground="{StaticResource Cash}"
                   TextAlignment="Center" TextWrapping="Wrap" />
        <TextBlock Text="{Binding ChangeOverlaySub}" FontSize="{StaticResource FontBody}"
                   Foreground="{StaticResource InkMuted}"
                   TextAlignment="Center" TextWrapping="Wrap" />
        <Button Classes="cash" Content="{Binding LblNextTicket}"
                Command="{Binding DismissChangeOverlayCommand}" Margin="0,10,0,0" />
      </StackPanel>
    </Border>
  </Border>
  </Grid>
</UserControl>
