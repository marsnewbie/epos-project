<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RingOrder.Epos.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="900"
        x:Class="RingOrder.Epos.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1440" Height="900"
        MinWidth="1200" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Title="RingOrder EPOS"
        Background="#e8eaed">

  <DockPanel>
    <!-- Top chrome -->
    <Border DockPanel.Dock="Top" Background="#ffffff" Padding="14,10"
            BorderBrush="#d0d5dd" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <TextBlock Text="{Binding ShopName}" FontSize="20" FontWeight="Bold"
                     Foreground="#c2410c" VerticalAlignment="Center" />
          <TextBlock Text="EPOS" FontSize="12" Foreground="#5b6472"
                     VerticalAlignment="Center" Margin="0,4,0,0" />
          <TextBlock Text="{Binding OnlineBadge}" FontSize="18" Foreground="#15803d"
                     VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding ClockText}" FontSize="18" FontWeight="SemiBold"
                   Foreground="#1c1917" VerticalAlignment="Center" Margin="0,0,16,0"
                   FontFamily="Consolas, Cascadia Mono, monospace" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
          <Button Classes="pos-nav" Content="{Binding LblLanguage}" Command="{Binding ToggleLanguageCommand}"
                  Width="100" Height="40" ToolTip.Tip="{Binding LanguageHint}" />
          <Button Classes="pos-nav" Content="{Binding LblDrawer}" Command="{Binding OpenDrawerCommand}"
                  Width="96" Height="40" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Status -->
    <Border DockPanel.Dock="Bottom" Background="#ffffff" Padding="14,8"
            BorderBrush="#d0d5dd" BorderThickness="0,1,0,0">
      <TextBlock Text="{Binding StatusText}" Foreground="#5b6472" FontSize="12"
                 TextTrimming="CharacterEllipsis" />
    </Border>

    <!-- Module rail — single language per UiLanguage -->
    <Border DockPanel.Dock="Left" Width="118" Background="#f4f6f8" Padding="8,10"
            BorderBrush="#d0d5dd" BorderThickness="0,0,1,0">
      <StackPanel>
        <Button Classes="pos-nav" Classes.active="{Binding IsSellNav}"
                Content="{Binding NavSell}" Command="{Binding GoSellCommand}" Height="64" FontSize="15" />
        <Button Classes="pos-nav" Classes.active="{Binding IsOrdersNav}"
                Content="{Binding NavOrders}" Command="{Binding GoOrdersCommand}" Height="64" FontSize="15" />
        <Button Classes="pos-nav" Classes.active="{Binding IsOnlineNav}"
                Content="{Binding NavOnline}" Command="{Binding GoOnlineCommand}" Height="64" FontSize="15" />
        <Button Classes="pos-nav" Classes.active="{Binding IsCustomersNav}"
                Content="{Binding NavCustomers}" Command="{Binding GoCustomersCommand}" Height="64" FontSize="14" />
        <Button Classes="pos-nav" Classes.active="{Binding IsSettingsNav}"
                Content="{Binding NavSettings}" Command="{Binding GoSettingsCommand}"
                Height="64" FontSize="15" Margin="0,12,0,0" />
      </StackPanel>
    </Border>

    <!-- Workspace -->
    <Border Background="#e8eaed" Padding="8">
      <ContentControl Content="{Binding CurrentPage}" />
    </Border>
  </DockPanel>
</Window>
