<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RingOrder.Epos.ViewModels"
             xmlns:domain="using:RingOrder.Epos.Domain"
             xmlns:conv="using:RingOrder.Epos.Converters"
             x:Class="RingOrder.Epos.Views.SellView"
             x:Name="Root"
             x:DataType="vm:SellViewModel"
             Background="#e8eaed">

  <Grid>
  <Grid ColumnDefinitions="148,*,420"
        IsEnabled="{Binding !ShowChangeOverlay}">

    <!-- Categories -->
    <Border Grid.Column="0" Classes="pos-panel" Padding="8" Margin="0,0,8,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
          <TextBox Classes="pos-field-sm" Watermark="{Binding WmSearch}"
                   Text="{Binding SearchText}" />
          <Grid ColumnDefinitions="*,56">
            <TextBox Classes="pos-field-sm" Watermark="{Binding WmDishNumber}"
                     Text="{Binding DishNumberText}" Margin="0,0,4,0" />
            <Button Grid.Column="1" Classes="pos-key-sm" Content="{Binding LblAdd}"
                    Command="{Binding AddByDishNumberCommand}" Margin="0" FontSize="13" />
          </Grid>
          <Button Classes="pos-nav" Content="{Binding LblPhoneOrder}"
                  Command="{Binding StartPhoneOrderCommand}" Height="40" />
        </StackPanel>
        <Button DockPanel.Dock="Bottom" Classes="pos-nav" Content="{Binding LblAdHoc}"
                Command="{Binding ToggleAdHocCommand}" Height="44" Margin="0,8,0,0" />
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding CategoryTiles}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CategoryTile">
                <Button Classes="pos-cat" Classes.active="{Binding IsSelected}"
                        Content="{Binding Name}"
                        Command="{Binding DataContext.SelectCategoryCommand, ElementName=Root}"
                        CommandParameter="{Binding Category}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Menu grid -->
    <Grid Grid.Column="1" Margin="0,0,8,0">
      <DockPanel>
        <Border DockPanel.Dock="Top" Padding="4,0,4,8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding CategoryHeading}" Classes="pos-title" />
            <TextBlock Grid.Column="1" Text="{Binding PanelStatus}" Foreground="#c2410c" FontSize="12"
                       VerticalAlignment="Center" MaxWidth="280" TextTrimming="CharacterEllipsis" />
          </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Classes="pos-panel" Padding="8" Margin="0,8,0,0"
                IsVisible="{Binding ShowAdHoc}">
          <Grid ColumnDefinitions="*,80,80,88">
            <TextBox Classes="pos-field" Watermark="{Binding WmAdHocName}" Text="{Binding AdHocName}" Margin="0,0,6,0" />
            <TextBox Grid.Column="1" Classes="pos-field" Watermark="£" Text="{Binding AdHocPrice}" Margin="0,0,6,0" />
            <TextBox Grid.Column="2" Classes="pos-field" Watermark="中文" Text="{Binding AdHocZh}" Margin="0,0,6,0" />
            <Button Grid.Column="3" Classes="pos-action pos-send" Content="{Binding LblAdd}"
                    Command="{Binding AddAdHocCommand}" Height="40" />
          </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Classes="pos-panel" Padding="8" Margin="0,8,0,0">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" MaxHeight="64">
            <ItemsControl ItemsSource="{Binding QuickNotes}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:QuickNoteItem">
                  <Button Classes="pos-chip" Content="{Binding ChipLabel}"
                          Command="{Binding DataContext.ApplyQuickNoteCommand, ElementName=Root}"
                          CommandParameter="{Binding}" ToolTip.Tip="{Binding Display}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="domain:MenuItem">
                <Button Classes="pos-dish"
                        Command="{Binding DataContext.SelectItemCommand, ElementName=Root}"
                        CommandParameter="{Binding}">
                  <StackPanel Spacing="1">
                    <TextBlock Text="{Binding MenuNumber}" FontSize="16" FontWeight="Bold" Foreground="#c2410c" />
                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold"
                               MaxHeight="32" Foreground="#1c1917" />
                    <TextBlock Text="{Binding ItemTranslation}" TextWrapping="Wrap" FontSize="11"
                               Foreground="#5b6472" MaxHeight="18" />
                    <TextBlock Text="{Binding BasePrice, StringFormat={}£{0:0.00}}" FontSize="12"
                               Foreground="#374151" FontWeight="SemiBold" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>

      <Border IsVisible="{Binding ShowModifierPanel}" Background="#99000000" CornerRadius="8" ZIndex="10">
        <Border Background="#ffffff" BorderBrush="#ea580c" BorderThickness="2" CornerRadius="12"
                Margin="20" Padding="0" MaxWidth="720" MaxHeight="640"
                HorizontalAlignment="Center" VerticalAlignment="Center">
          <DockPanel>
            <Border DockPanel.Dock="Top" Background="#fff7ed" Padding="16,12" CornerRadius="12,12,0,0">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="{Binding ModifierTitle}" FontSize="20" FontWeight="Bold"
                             Foreground="#1c1917" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding ModifierHint}" Foreground="#5b6472" FontSize="12"
                             TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                  <TextBlock Text="{Binding ModifierPriceText}" FontSize="22" FontWeight="Bold"
                             Foreground="#c2410c" HorizontalAlignment="Right" />
                </StackPanel>
              </Grid>
            </Border>
            <Border DockPanel.Dock="Bottom" Padding="12" Background="#f4f6f8" CornerRadius="0,0,12,12">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding ModifierError}" Foreground="#b91c1c" FontSize="13"
                           TextWrapping="Wrap" />
                <TextBox Classes="pos-field-sm" Watermark="{Binding WmOrderNotes}" Text="{Binding LineNotesDraft}" Margin="0" />
                <Grid ColumnDefinitions="*,2*">
                  <Button Classes="pos-nav" Content="{Binding LblCancel}" Command="{Binding CancelModifierCommand}"
                          Height="52" Margin="0,0,8,0" />
                  <Button Grid.Column="1" Classes="pos-action pos-cash" Content="{Binding LblAddToTicket}"
                          Command="{Binding AddSelectedItemCommand}" Height="52" />
                </Grid>
              </StackPanel>
            </Border>
            <ScrollViewer Padding="14,10" MaxHeight="420">
              <ItemsControl ItemsSource="{Binding ModifierGroups}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ModifierGroupVm">
                    <Border Background="#f8fafc" CornerRadius="8" Padding="12" Margin="0,0,0,10"
                            BorderBrush="#d0d5dd" BorderThickness="1">
                      <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" Foreground="#1c1917" />
                          <Border Background="#e8eaed" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TypeLabel}" FontSize="10" FontWeight="SemiBold" Foreground="#c2410c" />
                          </Border>
                          <Border Background="#fee2e2" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                  IsVisible="{Binding IsRequired}">
                            <TextBlock Text="{Binding DataContext.LblRequired, ElementName=Root}" FontSize="10"
                                       FontWeight="Bold" Foreground="#b91c1c" />
                          </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding ConditionalNote}" Foreground="#c2410c" FontSize="11"
                                   IsVisible="{Binding IsConditional}" />
                        <TextBlock Text="{Binding Hint}" Foreground="#5b6472" FontSize="12" />
                        <ItemsControl ItemsSource="{Binding Choices}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <WrapPanel />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ModifierChoiceVm">
                              <Button Classes="pos-opt" Classes.active="{Binding IsSelected}" Classes.multi="{Binding IsMulti}"
                                      IsEnabled="{Binding IsEnabled}" Margin="0,0,8,8" MinWidth="140" MaxWidth="220"
                                      Command="{Binding DataContext.ToggleOptionCommand, ElementName=Root}"
                                      CommandParameter="{Binding}">
                                <Grid ColumnDefinitions="22,*" Margin="2,0">
                                  <TextBlock Text="{Binding Glyph}" FontSize="16" VerticalAlignment="Center"
                                             Foreground="#c2410c" />
                                  <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="13"
                                               TextWrapping="Wrap" Foreground="#1c1917" />
                                    <Grid ColumnDefinitions="*,Auto">
                                      <TextBlock Text="{Binding Translation}" FontSize="11" Foreground="#5b6472"
                                                 TextTrimming="CharacterEllipsis" />
                                      <TextBlock Grid.Column="1" Text="{Binding PriceDeltaText}" FontSize="11"
                                                 FontWeight="Bold" Foreground="#c2410c" Margin="6,0,0,0" />
                                    </Grid>
                                  </StackPanel>
                                </Grid>
                              </Button>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Border>
    </Grid>

    <!-- Ticket column -->
    <Border Grid.Column="2" Classes="pos-panel" Padding="0" ClipToBounds="True">
      <Grid>
        <DockPanel Margin="10">

          <Border DockPanel.Dock="Top" Background="#fff7ed" CornerRadius="8" Padding="10,8" Margin="0,0,0,8"
                  BorderBrush="#fdba74" BorderThickness="1">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="{Binding TicketNumberText}" FontSize="18" FontWeight="Bold" Foreground="#1c1917" />
                <Border Background="#c2410c" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                  <TextBlock Text="{Binding TicketStatusBadge}" FontWeight="Bold" FontSize="11" Foreground="#fff7ed" />
                </Border>
              </StackPanel>
              <Button Grid.Column="1" Classes="pos-nav" Content="{Binding HeldButtonText}"
                      Command="{Binding ToggleHeldPanelCommand}" MinWidth="78" Height="36" Margin="0,0,4,0" FontSize="12" />
              <Button Grid.Column="2" Classes="pos-nav" Content="{Binding LblNew}"
                      Command="{Binding NewTicketCommand}" Width="64" Height="36" Margin="0,0,4,0" FontSize="12" />
              <Button Grid.Column="3" Classes="pos-nav" Content="{Binding LblClear}"
                      Command="{Binding ClearTicketCommand}" Width="64" Height="36" FontSize="12" />
            </Grid>
          </Border>

          <Border DockPanel.Dock="Top" Background="#f4f6f8" CornerRadius="8" Padding="8" Margin="0,0,0,8"
                  IsVisible="{Binding ShowHeldPanel}" BorderBrush="#d0d5dd" BorderThickness="1">
            <ItemsControl ItemsSource="{Binding HeldOrders}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="domain:PosOrder">
                  <Button Classes="pos-chip" Margin="0,0,6,4" HorizontalAlignment="Left"
                          Command="{Binding DataContext.ResumeHeldCommand, ElementName=Root}"
                          CommandParameter="{Binding}">
                    <TextBlock FontSize="12">
                      <Run Text="{Binding HoldLabel}" />
                      <Run Text=" " />
                      <Run Text="{Binding Total, StringFormat={}£{0:0.00}}" />
                    </TextBlock>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>

          <UniformGrid DockPanel.Dock="Top" Columns="4" Margin="0,0,0,6">
            <Button Classes="pos-type" Classes.active="{Binding IsCollection}" Content="{Binding LblTypeCollection}"
                    Command="{Binding SetOrderTypeCommand}" CommandParameter="Collection" Margin="0,0,4,0" />
            <Button Classes="pos-type" Classes.active="{Binding IsDelivery}" Content="{Binding LblTypeDelivery}"
                    Command="{Binding SetOrderTypeCommand}" CommandParameter="Delivery" Margin="0,0,4,0" />
            <Button Classes="pos-type" Classes.active="{Binding IsWalkIn}" Content="{Binding LblTypeWaiting}"
                    Command="{Binding SetOrderTypeCommand}" CommandParameter="WalkIn" Margin="0,0,4,0" />
            <Button Classes="pos-type" Classes.active="{Binding IsEatIn}" Content="{Binding LblTypeTable}"
                    Command="{Binding SetOrderTypeCommand}" CommandParameter="EatIn" />
          </UniformGrid>

          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <Grid ColumnDefinitions="*,*">
              <TextBox Classes="pos-field-sm" Watermark="{Binding WmName}" Text="{Binding CustomerName}" Margin="0,0,4,4" />
              <TextBox Grid.Column="1" Classes="pos-field-sm" Watermark="{Binding WmPhone}" Text="{Binding CustomerPhone}" Margin="0,0,0,4" />
            </Grid>
            <TextBox Classes="pos-field-sm" Watermark="{Binding WmAddress}" Text="{Binding DeliveryAddress}"
                     IsVisible="{Binding IsDelivery}" />
            <TextBox Classes="pos-field-sm" Watermark="{Binding WmPostcode}" Text="{Binding DeliveryPostcode}"
                     IsVisible="{Binding IsDelivery}" />
            <TextBox Classes="pos-field-sm" Watermark="{Binding WmTable}" Text="{Binding TableNumber}"
                     IsVisible="{Binding IsEatIn}" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding CustomerSummary}" Classes="pos-muted" FontSize="11"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                         IsVisible="{Binding !ShowCustomerMore}" />
              <Button Grid.Column="1" Classes="pos-nav" Content="{Binding LblNotes}"
                      Command="{Binding ToggleCustomerMoreCommand}" Width="72" Height="28" FontSize="11" Margin="0" />
            </Grid>
            <TextBox Classes="pos-field-sm" Watermark="{Binding WmOrderNotes}" Text="{Binding OrderNotes}"
                     IsVisible="{Binding ShowCustomerMore}" />
          </StackPanel>

          <Border DockPanel.Dock="Bottom" Classes="pos-ticket-footer" Margin="0,8,0,0"
                  IsVisible="{Binding !ShowCashPanel}">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="4" IsEnabled="{Binding CanEditSelectedLine}">
                  <Button Classes="pos-key-sm" Content="−" Command="{Binding QtyMinusCommand}" Width="44" Margin="0,0,4,0" />
                  <Button Classes="pos-key-sm" Content="+" Command="{Binding QtyPlusCommand}" Width="44" Margin="0,0,4,0" />
                  <Button Classes="pos-key-sm" Content="⌫" Command="{Binding RemoveLineCommand}" Width="44" Margin="0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding ItemsCountText}" Classes="pos-muted" FontSize="12" />
                  <TextBlock Text="{Binding PaymentSummaryText}" FontSize="11" Foreground="#c2410c"
                             IsVisible="{Binding HasPayments}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                  <TextBlock Text="{Binding Total, StringFormat={}£{0:0.00}}"
                             FontSize="26" FontWeight="Bold" Foreground="#1c1917" HorizontalAlignment="Right" />
                  <TextBlock Text="{Binding DeliveryFee, StringFormat=+ £{0:0.00}}"
                             Classes="pos-muted" FontSize="11" HorizontalAlignment="Right"
                             IsVisible="{Binding IsDelivery}" />
                  <TextBlock HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="#b45309"
                             IsVisible="{Binding HasPayments}">
                    <Run Text="{Binding DueLabel}" />
                    <Run Text=" " />
                    <Run Text="{Binding BalanceDueText}" />
                  </TextBlock>
                </StackPanel>
              </Grid>

              <Button Classes="pos-action pos-send" Content="{Binding SendButtonText}"
                      Command="{Binding SendKitchenCommand}" Height="50" />
              <Grid ColumnDefinitions="*,*,*">
                <Button Grid.Column="0" Classes="pos-action pos-hold" Content="{Binding LblHold}"
                        Command="{Binding HoldTicketCommand}" Margin="0,0,4,0" Height="48" />
                <Button Grid.Column="1" Classes="pos-action pos-cash" Content="{Binding LblPayCash}"
                        Command="{Binding BeginCashPayCommand}" Margin="0,0,4,0" Height="48" />
                <Button Grid.Column="2" Classes="pos-action pos-card" Content="{Binding LblPayCard}"
                        Command="{Binding PayCardCommand}" Height="48" />
              </Grid>
            </StackPanel>
          </Border>

          <Border DockPanel.Dock="Bottom" Classes="pos-ticket-footer" Margin="0,8,0,0"
                  IsVisible="{Binding ShowCashPanel}">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Classes="pos-muted" FontSize="11">
                    <Run Text="{Binding DueLabel}" />
                    <Run Text=" " />
                    <Run Text="{Binding BalanceDueText}" FontWeight="Bold" />
                  </TextBlock>
                  <TextBlock Text="{Binding LblCashTender}" Classes="pos-muted" FontSize="11" Margin="0,4,0,0" />
                  <TextBlock Text="{Binding CashTenderedText, StringFormat={}£{0}}" FontSize="26"
                             FontWeight="Bold" Foreground="#15803d" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                  <TextBlock Text="{Binding Total, StringFormat={}£{0:0.00}}" Foreground="#1c1917"
                             FontWeight="SemiBold" HorizontalAlignment="Right" />
                  <TextBlock IsVisible="{Binding HasPayments}" HorizontalAlignment="Right" FontSize="11" Foreground="#5b6472">
                    <Run Text="{Binding PaidLabel}" />
                    <Run Text=" £" />
                    <Run Text="{Binding AmountPaid, StringFormat={}{0:0.00}}" />
                  </TextBlock>
                  <TextBlock Text="{Binding ChangeText}" Foreground="#b45309" FontWeight="Bold"
                             FontSize="15" HorizontalAlignment="Right" Margin="0,4,0,0" />
                </StackPanel>
              </Grid>
              <UniformGrid Columns="4">
                <Button Classes="pos-key" Content="1" Command="{Binding CashDigitCommand}" CommandParameter="1" />
                <Button Classes="pos-key" Content="2" Command="{Binding CashDigitCommand}" CommandParameter="2" />
                <Button Classes="pos-key" Content="3" Command="{Binding CashDigitCommand}" CommandParameter="3" />
                <Button Classes="pos-key" Content="£10" Command="{Binding CashQuickCommand}" CommandParameter="10" />
                <Button Classes="pos-key" Content="4" Command="{Binding CashDigitCommand}" CommandParameter="4" />
                <Button Classes="pos-key" Content="5" Command="{Binding CashDigitCommand}" CommandParameter="5" />
                <Button Classes="pos-key" Content="6" Command="{Binding CashDigitCommand}" CommandParameter="6" />
                <Button Classes="pos-key" Content="£20" Command="{Binding CashQuickCommand}" CommandParameter="20" />
                <Button Classes="pos-key" Content="7" Command="{Binding CashDigitCommand}" CommandParameter="7" />
                <Button Classes="pos-key" Content="8" Command="{Binding CashDigitCommand}" CommandParameter="8" />
                <Button Classes="pos-key" Content="9" Command="{Binding CashDigitCommand}" CommandParameter="9" />
                <Button Classes="pos-key" Content="£50" Command="{Binding CashQuickCommand}" CommandParameter="50" />
                <Button Classes="pos-key" Content="⌫" Command="{Binding CashBackspaceCommand}" FontSize="20" />
                <Button Classes="pos-key" Content="0" Command="{Binding CashDigitCommand}" CommandParameter="0" />
                <Button Classes="pos-key" Content="." Command="{Binding CashDigitCommand}" CommandParameter="." />
                <Button Classes="pos-key" Content="{Binding LblExact}" Command="{Binding CashExactCommand}" />
              </UniformGrid>
              <Grid ColumnDefinitions="*,*,2*">
                <Button Grid.Column="0" Classes="pos-nav" Content="{Binding LblBack}"
                        Command="{Binding CancelCashPayCommand}" Height="52" Margin="0,0,4,0" />
                <Button Grid.Column="1" Classes="pos-nav" Content="{Binding LblClearCash}"
                        Command="{Binding CashClearCommand}" Height="52" Margin="0,0,4,0" />
                <Button Grid.Column="2" Classes="pos-action pos-cash" Content="{Binding LblConfirmCash}"
                        Command="{Binding PayCashCommand}" Height="52" />
              </Grid>
              <Button Classes="pos-action pos-card" Content="{Binding LblPayCardOnPad}"
                      Command="{Binding PayCardCommand}" Height="44" />
              <Button Classes="pos-nav" Content="{Binding LblPrintInterim}"
                      Command="{Binding PrintInterimReceiptCommand}" Height="40"
                      IsVisible="{Binding HasPayments}" />
            </StackPanel>
          </Border>

          <Grid>
            <ListBox Classes="pos-ticket" ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}"
                     IsVisible="{Binding !IsTicketEmpty}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="domain:CartLine">
                  <Border Padding="10,8" Opacity="{Binding KitchenSent, Converter={x:Static conv:BoolToOpacityConverter.Instance}}">
                    <Grid ColumnDefinitions="44,*,72">
                      <Border Background="#fff7ed" CornerRadius="6" Width="40" Height="40"
                              VerticalAlignment="Top" HorizontalAlignment="Left"
                              BorderBrush="#fdba74" BorderThickness="1">
                        <TextBlock Text="{Binding Quantity}" FontWeight="Bold" FontSize="18" Foreground="#c2410c"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <StackPanel Grid.Column="1" Margin="10,0,8,0">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="{Binding Name}" TextWrapping="Wrap" Foreground="#1c1917"
                                     FontWeight="SemiBold" FontSize="14" />
                          <Border Grid.Column="1" Background="#ffedd5" CornerRadius="3" Padding="6,2"
                                  Margin="6,0,0,0" VerticalAlignment="Top"
                                  IsVisible="{Binding KitchenSent}">
                            <TextBlock Text="{Binding DataContext.LblLineSent, ElementName=Root}"
                                       FontSize="9" FontWeight="Bold" Foreground="#c2410c" />
                          </Border>
                        </Grid>
                        <TextBlock Text="{Binding ItemTranslation}" Foreground="#5b6472" FontSize="12"
                                   IsVisible="{Binding HasTranslation}" />
                        <TextBlock Text="{Binding OptionsSummary}" TextWrapping="Wrap" Foreground="#6b7280"
                                   FontSize="11" Margin="0,2,0,0" IsVisible="{Binding HasExtras}" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding LineTotal, StringFormat={}£{0:0.00}}"
                                 FontWeight="Bold" FontSize="15" Foreground="#1c1917"
                                 HorizontalAlignment="Right" VerticalAlignment="Top" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel IsVisible="{Binding IsTicketEmpty}" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Opacity="0.7" Margin="20">
              <TextBlock Text="{Binding LblTicket}" FontSize="13" FontWeight="Bold" Foreground="#9aa3b2"
                         HorizontalAlignment="Center" LetterSpacing="2" />
              <TextBlock Text="{Binding EmptyTicketHint}" FontSize="14" Foreground="#5b6472"
                         HorizontalAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
          </Grid>
        </DockPanel>
      </Grid>
    </Border>
  </Grid>

  <!-- Full-screen settlement: must acknowledge before any Sell work continues -->
  <Border IsVisible="{Binding ShowChangeOverlay}" Background="#E0000000" ZIndex="100">
    <Border Background="#ffffff" CornerRadius="12" Padding="28" Margin="24"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            BorderBrush="#15803d" BorderThickness="3" MinWidth="300" MaxWidth="420">
      <StackPanel Spacing="12">
        <TextBlock Text="{Binding ChangeOverlayText}" FontSize="32" FontWeight="Bold"
                   Foreground="#15803d" TextAlignment="Center" TextWrapping="Wrap" />
        <TextBlock Text="{Binding ChangeOverlaySub}" FontSize="14" Foreground="#5b6472"
                   TextAlignment="Center" TextWrapping="Wrap" />
        <Button Classes="pos-action pos-cash" Content="{Binding LblNextTicket}"
                Command="{Binding DismissChangeOverlayCommand}" Height="52" Margin="0,8,0,0" />
      </StackPanel>
    </Border>
  </Border>
  </Grid>
</UserControl>
