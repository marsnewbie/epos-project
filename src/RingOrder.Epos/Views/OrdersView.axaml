<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RingOrder.Epos.ViewModels"
             xmlns:domain="using:RingOrder.Epos.Domain"
             x:Class="RingOrder.Epos.Views.OrdersView"
             x:DataType="vm:OrdersViewModel"
             Background="#e8eaed">
  <Grid ColumnDefinitions="1.1*,*" Margin="4">
    <Border Grid.Column="0" Classes="panel" Padding="10" Margin="0,0,8,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10" Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding LblToday}" Classes="title" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="btn" Content="{Binding LblRefresh}" Click="OnRefresh"
                    Width="110" Height="40" />
          </Grid>
          <UniformGrid Columns="4">
            <Button Classes="btn" Classes.on="{Binding FilterAll}" Content="{Binding LblFilterAll}"
                    Command="{Binding SetFilterCommand}" CommandParameter="All" Height="40" Margin="0,0,4,0" />
            <Button Classes="btn" Classes.on="{Binding FilterUnpaid}" Content="{Binding LblFilterUnpaid}"
                    Command="{Binding SetFilterCommand}" CommandParameter="Unpaid" Height="40" Margin="0,0,4,0" />
            <Button Classes="btn" Classes.on="{Binding FilterHeld}" Content="{Binding LblFilterHeld}"
                    Command="{Binding SetFilterCommand}" CommandParameter="Held" Height="40" Margin="0,0,4,0" />
            <Button Classes="btn" Classes.on="{Binding FilterPaid}" Content="{Binding LblFilterPaid}"
                    Command="{Binding SetFilterCommand}" CommandParameter="Paid" Height="40" />
          </UniformGrid>
          <TextBlock Text="{Binding TodaySummary}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>
        <ListBox Classes="ticket" ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="domain:PosOrder">
              <Grid ColumnDefinitions="*,Auto" Margin="10,8">
                <StackPanel>
                  <TextBlock FontWeight="Bold" FontSize="15" Foreground="#1c1917" Text="{Binding OrderNumber}" />
                  <TextBlock FontSize="12" Foreground="#c2410c" Margin="0,2,0,0">
                    <Run Text="{Binding OrderType}" />
                    <Run Text=" · " />
                    <Run Text="{Binding Status}" />
                  </TextBlock>
                  <TextBlock FontSize="12" Foreground="#5b6472" Text="{Binding CustomerName}" />
                  <TextBlock FontSize="11" Foreground="#9aa3b2" Text="{Binding HoldLabel}" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                  <TextBlock FontSize="18" FontWeight="Bold" Foreground="#1c1917"
                             Text="{Binding Total, StringFormat={}£{0:0.00}}" HorizontalAlignment="Right" />
                  <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#b45309" HorizontalAlignment="Right"
                             IsVisible="{Binding IsUnpaid}"
                             Text="{Binding BalanceDue, StringFormat=Due £{0:0.00}}" />
                  <TextBlock FontSize="11" Foreground="#15803d" HorizontalAlignment="Right"
                             IsVisible="{Binding HasPayments}"
                             Text="{Binding AmountPaid, StringFormat=Paid £{0:0.00}}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <Border Grid.Column="1" Classes="panel" Padding="10">
      <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,10,0,0">
          <Button Classes="cash" Content="{Binding LblOpenOnSell}"
                  Command="{Binding OpenOnSellCommand}" Height="48" />
          <Button Classes="primary" Content="{Binding LblReopen}"
                  Command="{Binding ReopenOrderCommand}" Height="48" />
          <Grid ColumnDefinitions="*,*">
            <Button Grid.Column="0" Classes="btn" Content="{Binding LblReprintKitchen}"
                    Command="{Binding ReprintKitchenCommand}" Margin="0,0,4,0" Height="44" />
            <Button Grid.Column="1" Classes="btn" Content="{Binding LblReprintFront}"
                    Command="{Binding ReprintFrontCommand}" Height="44" />
          </Grid>
          <Button Classes="danger" Content="{Binding LblVoid}"
                  Command="{Binding VoidOrderCommand}" Height="44" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding LblDetail}" FontWeight="Bold"
                   Foreground="#5b6472" Margin="0,0,0,8" />
        <TextBox Text="{Binding DetailText}" AcceptsReturn="True" IsReadOnly="True" TextWrapping="Wrap"
                 Classes="field" MinHeight="200" />
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
