<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RingOrder.Epos.ViewModels"
             xmlns:domain="using:RingOrder.Epos.Domain"
             x:Class="RingOrder.Epos.Views.OnlineView"
             x:DataType="vm:OnlineViewModel"
             Background="#e8eaed">
  <DockPanel Margin="4">
    <Border DockPanel.Dock="Top" Classes="pos-panel" Padding="10" Margin="0,0,0,8"
            IsVisible="{Binding SetupNeeded}">
      <StackPanel Spacing="6">
        <TextBlock Text="{Binding LblSetupTitle}" FontSize="16" FontWeight="Bold" Foreground="#c2410c" />
        <TextBlock Text="{Binding SetupHint}" TextWrapping="Wrap" Foreground="#1c1917" LineHeight="20" />
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Top" Classes="pos-panel" Padding="14" Margin="0,0,0,8">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Button Classes="pos-action pos-cash" Content="{Binding LblToggle}"
                Command="{Binding ToggleAcceptingCommand}" Width="260" Height="72" FontSize="18" FontWeight="Bold" />
        <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center" Spacing="4">
          <TextBlock Text="{Binding LblAccepting}" FontSize="16" FontWeight="Bold" Foreground="#15803d" />
          <TextBlock Text="{Binding PollerStatus}" Foreground="#c2410c" FontWeight="SemiBold" TextWrapping="Wrap" />
        </StackPanel>
        <Button Grid.Column="2" Classes="pos-nav" Content="{Binding LblAdvanced}" Command="{Binding ToggleAdvancedCommand}"
                Width="120" Height="44" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Border DockPanel.Dock="Top" Background="#f4f6f8" CornerRadius="8" Padding="10" Margin="0,0,0,8"
            BorderBrush="#d0d5dd" BorderThickness="1"
            IsVisible="{Binding ShowAdvanced}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="pos-nav" Content="{Binding LblPollOnce}" Command="{Binding PollOnceCommand}" Width="130" Height="40" />
        <Button Classes="pos-nav" Content="{Binding LblTest}" Command="{Binding TestConnectionCommand}" Width="150" Height="40" />
        <Button Classes="pos-nav" Content="{Binding LblReprintKitchen}" Command="{Binding ReprintKitchenCommand}" Width="150" Height="40" />
        <Button Classes="pos-nav" Content="{Binding LblAck}" Command="{Binding AckAgainCommand}" Width="130" Height="40" />
      </StackPanel>
    </Border>

    <Grid ColumnDefinitions="1.1*,*">
      <Border Grid.Column="0" Classes="pos-panel" Padding="10" Margin="0,0,8,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="{Binding LblOrdersTitle}" Classes="pos-title" Margin="0,0,0,8" />
          <ListBox Classes="pos-ticket" ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="domain:PosOrder">
                <Grid ColumnDefinitions="*,Auto" Margin="10,8">
                  <StackPanel>
                    <TextBlock FontWeight="Bold" FontSize="15" Foreground="#1c1917" Text="{Binding OrderNumber}" />
                    <TextBlock Foreground="#5b6472" FontSize="12" Text="{Binding CustomerName}" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" FontSize="18" FontWeight="Bold" Foreground="#1c1917"
                             Text="{Binding Total, StringFormat={}£{0:0.00}}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      <Border Grid.Column="1" Classes="pos-panel" Padding="10">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="{Binding LblDetail}" FontWeight="Bold"
                     Foreground="#5b6472" Margin="0,0,0,8" />
          <TextBox Text="{Binding DetailText}" IsReadOnly="True" AcceptsReturn="True"
                   TextWrapping="Wrap" Classes="pos-field" />
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
