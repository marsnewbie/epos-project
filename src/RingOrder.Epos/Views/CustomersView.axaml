<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RingOrder.Epos.ViewModels"
             xmlns:domain="using:RingOrder.Epos.Domain"
             x:Class="RingOrder.Epos.Views.CustomersView"
             x:DataType="vm:CustomersViewModel"
             Background="#e8eaed">
  <Grid ColumnDefinitions="*,*" Margin="4">
    <Border Grid.Column="0" Classes="panel" Padding="10" Margin="0,0,8,0">
      <DockPanel>
        <TextBox DockPanel.Dock="Top" Classes="field" Watermark="{Binding WmSearch}"
                 Text="{Binding SearchText}" Margin="0,0,0,8" />
        <TextBlock DockPanel.Dock="Top" Text="{Binding LblTitle}" Classes="title" Margin="0,0,0,8" />
        <ListBox Classes="ticket" ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="domain:Customer">
              <StackPanel Margin="10,8">
                <TextBlock FontWeight="Bold" FontSize="15" Foreground="#1c1917" Text="{Binding Name}" />
                <TextBlock FontSize="14" Foreground="#c2410c" Text="{Binding Phone}" Margin="0,2,0,0" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <Border Grid.Column="1" Classes="panel" Padding="14">
      <StackPanel Spacing="4" MaxWidth="480">
        <TextBlock Text="{Binding LblCustomer}" Classes="title" Margin="0,0,0,8" />
        <TextBox Classes="field" Watermark="{Binding WmName}" Text="{Binding EditName}" />
        <TextBox Classes="field" Watermark="{Binding WmPhone}" Text="{Binding EditPhone}" />
        <Grid ColumnDefinitions="*,Auto">
          <TextBox Classes="field" Watermark="{Binding WmPostcode}" Text="{Binding EditPostcode}" />
          <Button Grid.Column="1" Classes="card" Width="96" Margin="6,0,0,0"
                  Content="{Binding AddressLookup.LblFind}"
                  Command="{Binding AddressLookup.FindCommand}"
                  IsEnabled="{Binding !AddressLookup.IsBusy}" />
        </Grid>
        <TextBox Classes="field" Watermark="{Binding WmAddress}" Text="{Binding EditAddress}" />

        <StackPanel DataContext="{Binding AddressLookup}">
          <TextBlock Text="{Binding Status}" Classes="muted" FontSize="12" TextWrapping="Wrap"
                     Margin="2,4,0,0" IsVisible="{Binding HasStatus}" />
          <ListBox IsVisible="{Binding HasCandidates}" ItemsSource="{Binding Candidates}"
                   SelectedItem="{Binding SelectedCandidate}"
                   Background="#ffffff" BorderBrush="#d0d5dd" BorderThickness="1"
                   CornerRadius="6" Margin="0,6,0,0" MaxHeight="220">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Display}" FontSize="13" TextWrapping="Wrap"
                           MinHeight="32" VerticalAlignment="Center" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
        <Button Classes="primary" Content="{Binding LblSave}" Command="{Binding SaveCustomerCommand}"
                HorizontalAlignment="Left" Width="200" Margin="0,8,0,0" />
        <Button Classes="cash" Content="{Binding LblStartOrder}"
                Command="{Binding StartOrderCommand}" HorizontalAlignment="Left" Width="200" Margin="0,8,0,0" Height="48" />

        <!-- An erasure request. Armed by the first press, done by the second. -->
        <Button Classes="danger" Content="{Binding LblErase}" Classes.on="{Binding EraseArmed}"
                Command="{Binding EraseCustomerCommand}"
                HorizontalAlignment="Left" Width="220" Margin="0,16,0,0" />

        <Border Background="#f4f6f8" CornerRadius="8" Padding="12" Margin="0,24,0,0"
                BorderBrush="#d0d5dd" BorderThickness="1">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding LblCallerId}" FontWeight="Bold" Foreground="#1c1917" />
            <TextBlock Text="{Binding LblCallerHint}" Classes="muted" FontSize="12" />
            <TextBox Classes="field" Text="{Binding SimulatePhone}" />
            <Button Classes="card" Content="{Binding LblSimulate}"
                    Command="{Binding SimulateCallerIdCommand}" HorizontalAlignment="Left" Width="240" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
