<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Control styles. Sizes and colours come from Tokens.axaml — no hex here
    either, so a shop-wide change is one edit rather than a search.
  -->

  <Style Selector="Window">
    <Setter Property="FontSize" Value="{StaticResource FontBody}" />
    <Setter Property="Background" Value="{StaticResource Page}" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
  </Style>

  <!-- ── Panels ───────────────────────────────────────────────────────────── -->

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{StaticResource Panel}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Border.panel-flat">
    <Setter Property="Background" Value="{StaticResource PanelAlt}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius}" />
  </Style>

  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="{StaticResource FontTitle}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{StaticResource InkMuted}" />
    <Setter Property="FontSize" Value="{StaticResource FontSmall}" />
  </Style>

  <Style Selector="TextBlock.money">
    <Setter Property="FontSize" Value="{StaticResource FontMoney}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <!-- ── Buttons ──────────────────────────────────────────────────────────── -->

  <Style Selector="Button">
    <Setter Property="FontSize" Value="{StaticResource FontBody}" />
    <Setter Property="MinHeight" Value="{StaticResource TouchCompact}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- Neutral: navigation, secondary actions -->
  <Style Selector="Button.btn">
    <Setter Property="Height" Value="{StaticResource TouchStandard}" />
    <Setter Property="Background" Value="{StaticResource Panel}" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,0" />
  </Style>
  <Style Selector="Button.btn:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource PanelAlt}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineStrong}" />
  </Style>
  <Style Selector="Button.btn:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentWash}" />
  </Style>
  <Style Selector="Button.btn.on /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Accent}" />
    <Setter Property="TextBlock.Foreground" Value="{StaticResource InkOnDark}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentDeep}" />
  </Style>

  <!-- Primary: the next step in the flow -->
  <Style Selector="Button.primary">
    <Setter Property="Height" Value="{StaticResource TouchPrimary}" />
    <Setter Property="FontSize" Value="{StaticResource FontStrong}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Background" Value="{StaticResource Accent}" />
    <Setter Property="Foreground" Value="{StaticResource InkOnDark}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentDeep}" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource BorderStrongColor}" />
  </Style>

  <!-- Money buttons: colour says what happens to the drawer -->
  <Style Selector="Button.cash">
    <Setter Property="Height" Value="{StaticResource TouchPrimary}" />
    <Setter Property="FontSize" Value="{StaticResource FontStrong}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Background" Value="{StaticResource Cash}" />
    <Setter Property="Foreground" Value="{StaticResource InkOnDark}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.card">
    <Setter Property="Height" Value="{StaticResource TouchPrimary}" />
    <Setter Property="FontSize" Value="{StaticResource FontStrong}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Background" Value="{StaticResource Card}" />
    <Setter Property="Foreground" Value="{StaticResource InkOnDark}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.hold">
    <Setter Property="Height" Value="{StaticResource TouchStandard}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Background" Value="{StaticResource Hold}" />
    <Setter Property="Foreground" Value="{StaticResource InkOnDark}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{StaticResource Danger}" />
    <Setter Property="Foreground" Value="{StaticResource InkOnDark}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- Module rail -->
  <Style Selector="Button.rail">
    <Setter Property="Height" Value="72" />
    <Setter Property="FontSize" Value="{StaticResource FontSmall}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource InkMuted}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.rail:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource PanelAlt}" />
  </Style>
  <Style Selector="Button.rail.on /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Panel}" />
    <Setter Property="TextBlock.Foreground" Value="{StaticResource Accent}" />
  </Style>

  <!-- Category tile: fixed size so its position never moves -->
  <Style Selector="Button.category">
    <Setter Property="Height" Value="{StaticResource TouchCategory}" />
    <Setter Property="FontSize" Value="{StaticResource FontSmall}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Background" Value="{StaticResource Panel}" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="6,0" />
  </Style>
  <Style Selector="Button.category.on /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Accent}" />
    <Setter Property="TextBlock.Foreground" Value="{StaticResource InkOnDark}" />
  </Style>

  <!-- Dish tile -->
  <Style Selector="Button.dish">
    <Setter Property="Height" Value="{StaticResource TouchDish}" />
    <Setter Property="Background" Value="{StaticResource Panel}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
  </Style>
  <Style Selector="Button.dish:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentWash}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentEdge}" />
  </Style>
  <Style Selector="Button.dish:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentEdge}" />
  </Style>
  <Style Selector="Button.dish.out /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource PanelAlt}" />
  </Style>

  <!-- Keypad -->
  <Style Selector="Button.key">
    <Setter Property="Height" Value="{StaticResource TouchPrimary}" />
    <Setter Property="FontSize" Value="{StaticResource FontTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Background" Value="{StaticResource Panel}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Margin" Value="3" />
  </Style>
  <Style Selector="Button.key:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentWash}" />
  </Style>
  <Style Selector="Button.key.tender">
    <Setter Property="Background" Value="{StaticResource CashWash}" />
    <Setter Property="FontSize" Value="{StaticResource FontStrong}" />
  </Style>

  <!-- Chips: quick notes, filters, held tickets -->
  <Style Selector="Button.chip">
    <Setter Property="Height" Value="{StaticResource TouchCompact}" />
    <Setter Property="FontSize" Value="{StaticResource FontSmall}" />
    <Setter Property="Background" Value="{StaticResource PanelAlt}" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="Margin" Value="0,0,6,6" />
  </Style>
  <Style Selector="Button.chip.on /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Accent}" />
    <Setter Property="TextBlock.Foreground" Value="{StaticResource InkOnDark}" />
  </Style>

  <!-- Option choice -->
  <Style Selector="Button.option">
    <Setter Property="MinHeight" Value="{StaticResource TouchStandard}" />
    <Setter Property="Background" Value="{StaticResource Panel}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.option.on /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentWash}" />
    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
  </Style>
  <Style Selector="Button.option:disabled /template/ ContentPresenter">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <!-- ── Inputs ───────────────────────────────────────────────────────────── -->

  <Style Selector="TextBox.field">
    <Setter Property="Height" Value="{StaticResource TouchCompact}" />
    <Setter Property="FontSize" Value="{StaticResource FontBody}" />
    <Setter Property="Background" Value="{StaticResource Panel}" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius}" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox.field:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!-- ── Ticket list ──────────────────────────────────────────────────────── -->

  <Style Selector="ListBox.ticket">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBox.ticket ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="{StaticResource TouchStandard}" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius}" />
  </Style>
  <Style Selector="ListBox.ticket ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentWash}" />
  </Style>

  <!-- ── Status pills ─────────────────────────────────────────────────────── -->

  <Style Selector="Border.pill">
    <Setter Property="CornerRadius" Value="{StaticResource Radius}" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.pill > TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontCaption}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Border.pill.ok">
    <Setter Property="Background" Value="{StaticResource OkWash}" />
  </Style>
  <Style Selector="Border.pill.ok > TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Ok}" />
  </Style>
  <Style Selector="Border.pill.warn">
    <Setter Property="Background" Value="{StaticResource HoldWash}" />
  </Style>
  <Style Selector="Border.pill.warn > TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Hold}" />
  </Style>
  <Style Selector="Border.pill.bad">
    <Setter Property="Background" Value="{StaticResource DangerWash}" />
  </Style>
  <Style Selector="Border.pill.bad > TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Danger}" />
  </Style>
  <Style Selector="Border.pill.accent">
    <Setter Property="Background" Value="{StaticResource Accent}" />
  </Style>
  <Style Selector="Border.pill.accent > TextBlock">
    <Setter Property="Foreground" Value="{StaticResource InkOnDark}" />
  </Style>

</Styles>
