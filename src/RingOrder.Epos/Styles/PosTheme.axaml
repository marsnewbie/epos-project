<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Counter POS: light high-contrast, chilli orange accent, large touch targets -->
  <Style Selector="Window">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Background" Value="#e8eaed" />
  </Style>

  <Style Selector="Button.pos-nav">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Height" Value="56" />
    <Setter Property="Margin" Value="0,0,0,6" />
    <Setter Property="Background" Value="#ffffff" />
    <Setter Property="Foreground" Value="#1c1917" />
    <Setter Property="BorderBrush" Value="#c4c9d1" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="8,4" />
  </Style>
  <Style Selector="Button.pos-nav:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#fff1e6" />
    <Setter Property="BorderBrush" Value="#ea580c" />
  </Style>
  <Style Selector="Button.pos-nav.active">
    <Setter Property="Background" Value="#ea580c" />
    <Setter Property="Foreground" Value="#ffffff" />
    <Setter Property="BorderBrush" Value="#c2410c" />
  </Style>
  <Style Selector="Button.pos-nav.active:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#c2410c" />
  </Style>

  <Style Selector="Button.pos-cat">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Height" Value="48" />
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="Background" Value="#ffffff" />
    <Setter Property="Foreground" Value="#1c1917" />
    <Setter Property="BorderBrush" Value="#c4c9d1" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.pos-cat:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#fff7ed" />
  </Style>
  <Style Selector="Button.pos-cat.active">
    <Setter Property="Background" Value="#ea580c" />
    <Setter Property="Foreground" Value="#ffffff" />
    <Setter Property="BorderBrush" Value="#c2410c" />
  </Style>

  <Style Selector="Button.pos-dish">
    <Setter Property="Width" Value="128" />
    <Setter Property="Height" Value="100" />
    <Setter Property="Margin" Value="3" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="Background" Value="#ffffff" />
    <Setter Property="Foreground" Value="#1c1917" />
    <Setter Property="BorderBrush" Value="#b8bec8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
  </Style>
  <Style Selector="Button.pos-dish:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#ffedd5" />
    <Setter Property="BorderBrush" Value="#ea580c" />
  </Style>
  <Style Selector="Button.pos-dish:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="#fdba74" />
  </Style>

  <Style Selector="Button.pos-type">
    <Setter Property="Height" Value="42" />
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="Background" Value="#ffffff" />
    <Setter Property="Foreground" Value="#1c1917" />
    <Setter Property="BorderBrush" Value="#c4c9d1" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Button.pos-type.active">
    <Setter Property="Background" Value="#ea580c" />
    <Setter Property="Foreground" Value="#ffffff" />
    <Setter Property="BorderBrush" Value="#c2410c" />
  </Style>

  <Style Selector="Button.pos-key">
    <Setter Property="Height" Value="48" />
    <Setter Property="Margin" Value="2" />
    <Setter Property="Background" Value="#ffffff" />
    <Setter Property="Foreground" Value="#1c1917" />
    <Setter Property="BorderBrush" Value="#9aa3b2" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Button.pos-key:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#e8eaed" />
  </Style>
  <Style Selector="Button.pos-key-sm">
    <Setter Property="Height" Value="40" />
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="Background" Value="#ffffff" />
    <Setter Property="Foreground" Value="#1c1917" />
    <Setter Property="BorderBrush" Value="#9aa3b2" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <Style Selector="Button.pos-action">
    <Setter Property="Height" Value="52" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.pos-send">
    <Setter Property="Background" Value="#c2410c" />
  </Style>
  <Style Selector="Button.pos-cash">
    <Setter Property="Background" Value="#15803d" />
  </Style>
  <Style Selector="Button.pos-card">
    <Setter Property="Background" Value="#1d4ed8" />
  </Style>
  <Style Selector="Button.pos-danger">
    <Setter Property="Background" Value="#b91c1c" />
  </Style>
  <Style Selector="Button.pos-hold">
    <Setter Property="Background" Value="#57534e" />
  </Style>

  <Style Selector="Button.pos-chip">
    <Setter Property="Height" Value="36" />
    <Setter Property="Margin" Value="0,0,6,6" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Background" Value="#ffffff" />
    <Setter Property="Foreground" Value="#1c1917" />
    <Setter Property="BorderBrush" Value="#c4c9d1" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Button.pos-chip.active">
    <Setter Property="Background" Value="#ea580c" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderBrush" Value="#c2410c" />
  </Style>
  <Style Selector="Button.pos-chip-opt">
    <Setter Property="Height" Value="40" />
    <Setter Property="Margin" Value="0,0,6,6" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Background" Value="#ffffff" />
    <Setter Property="Foreground" Value="#1c1917" />
    <Setter Property="BorderBrush" Value="#c4c9d1" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="Button.pos-chip-opt.active">
    <Setter Property="Background" Value="#ea580c" />
    <Setter Property="Foreground" Value="#ffffff" />
  </Style>

  <Style Selector="Button.pos-opt">
    <Setter Property="MinHeight" Value="52" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Background" Value="#ffffff" />
    <Setter Property="Foreground" Value="#1c1917" />
    <Setter Property="BorderBrush" Value="#b8bec8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="24" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.pos-opt.multi">
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Button.pos-opt:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#fff7ed" />
  </Style>
  <Style Selector="Button.pos-opt.active">
    <Setter Property="Background" Value="#ffedd5" />
    <Setter Property="BorderBrush" Value="#ea580c" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Button.pos-opt:disabled">
    <Setter Property="Opacity" Value="0.4" />
  </Style>

  <Style Selector="TextBox.pos-field">
    <Setter Property="Height" Value="40" />
    <Setter Property="Margin" Value="0,0,0,6" />
    <Setter Property="Background" Value="#ffffff" />
    <Setter Property="Foreground" Value="#1c1917" />
    <Setter Property="BorderBrush" Value="#9aa3b2" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CaretBrush" Value="#1c1917" />
  </Style>
  <Style Selector="TextBox.pos-field-sm">
    <Setter Property="Height" Value="34" />
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="Background" Value="#ffffff" />
    <Setter Property="Foreground" Value="#1c1917" />
    <Setter Property="BorderBrush" Value="#9aa3b2" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CaretBrush" Value="#1c1917" />
  </Style>

  <Style Selector="ListBox.pos-ticket">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBox.pos-ticket ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,0,6" />
    <Setter Property="Background" Value="#ffffff" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="MinHeight" Value="52" />
    <Setter Property="BorderBrush" Value="#d5dae3" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="ListBox.pos-ticket ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="#ffedd5" />
  </Style>
  <Style Selector="ListBox.pos-ticket ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#f4f6f8" />
  </Style>

  <Style Selector="Border.pos-panel">
    <Setter Property="Background" Value="#ffffff" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="BorderBrush" Value="#d0d5dd" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Border.pos-ticket-footer">
    <Setter Property="Background" Value="#f4f6f8" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="BorderBrush" Value="#d0d5dd" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="TextBlock.pos-title">
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="Foreground" Value="#1c1917" />
  </Style>
  <Style Selector="TextBlock.pos-muted">
    <Setter Property="Foreground" Value="#5b6472" />
  </Style>
  <Style Selector="TextBlock.pos-body">
    <Setter Property="Foreground" Value="#1c1917" />
  </Style>
  <Style Selector="CheckBox">
    <Setter Property="Foreground" Value="#1c1917" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="Background" Value="#ffffff" />
    <Setter Property="Foreground" Value="#1c1917" />
    <Setter Property="BorderBrush" Value="#9aa3b2" />
  </Style>

</Styles>
