<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MagicWok.Epos.ViewModels"
             xmlns:domain="using:MagicWok.Epos.Domain"
             x:Class="MagicWok.Epos.Views.OnlineView"
             x:DataType="vm:OnlineViewModel"
             Background="#1c1917">
  <Grid ColumnDefinitions="1.1*,*" RowDefinitions="Auto,Auto,*" Margin="4">
    <Border Grid.ColumnSpan="2" Background="#141210" CornerRadius="8" Padding="10" Margin="0,0,0,8"
            IsVisible="{Binding SetupNeeded}">
      <StackPanel Spacing="6">
        <TextBlock Text="Online setup / 线上配置" FontSize="16" FontWeight="Bold" Foreground="#fb923c" />
        <TextBlock Text="{Binding SetupHint}" TextWrapping="Wrap" Foreground="#e7e5e4" LineHeight="20" />
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#141210" CornerRadius="8" Padding="10" Margin="0,0,0,8">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="pos-action pos-cash" Content="Start poller" Command="{Binding StartPollerCommand}" Width="130" Height="44" />
          <Button Classes="pos-nav" Content="Stop" Command="{Binding StopPollerCommand}" Width="80" Height="44" />
          <Button Classes="pos-action pos-send" Content="Poll once" Command="{Binding PollOnceCommand}" Width="120" Height="44" />
          <Button Classes="pos-nav" Content="Test connection" Command="{Binding TestConnectionCommand}" Width="140" Height="44" />
          <Button Classes="pos-nav" Content="Reprint kitchen" Command="{Binding ReprintKitchenCommand}" Width="140" Height="44" />
          <Button Classes="pos-nav" Content="Ack printed" Command="{Binding AckAgainCommand}" Width="120" Height="44" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding PollerStatus}" Foreground="#fdba74" VerticalAlignment="Center"
                   Margin="16,0" FontWeight="SemiBold" TextWrapping="Wrap" />
        <Border Grid.Column="2" Background="#292524" CornerRadius="6" Padding="12,8" VerticalAlignment="Center">
          <StackPanel>
            <TextBlock Foreground="#86efac" FontWeight="Bold"
                       Text="{Binding PollingEnabled, StringFormat=Polling: {0}}" />
            <TextBlock Foreground="#a8a29e" FontSize="11"
                       Text="{Binding CredentialsOk, StringFormat=Credentials: {0}}" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Border Grid.Row="2" Grid.Column="0" Background="#141210" CornerRadius="8" Padding="10" Margin="0,0,8,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Online queue / 线上单" FontSize="18" FontWeight="Bold"
                   Foreground="#fafaf9" Margin="0,0,0,8" />
        <ListBox Classes="pos-ticket" ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="domain:PosOrder">
              <Grid ColumnDefinitions="*,Auto" Margin="10,8">
                <StackPanel>
                  <TextBlock FontWeight="Bold" FontSize="15" Foreground="#fafaf9" Text="{Binding OrderNumber}" />
                  <TextBlock Foreground="#a8a29e" FontSize="12" Text="{Binding CustomerName}" />
                  <TextBlock Foreground="#78716c" FontSize="11" Text="{Binding CustomerPhone}" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                  <TextBlock FontSize="18" FontWeight="Bold" Foreground="#fafaf9"
                             Text="{Binding Total, StringFormat={}£{0:0.00}}" />
                  <TextBlock FontSize="11" Foreground="#86efac" HorizontalAlignment="Right"
                             Text="{Binding KitchenPrinted, StringFormat=Kitchen {0}}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <Border Grid.Row="2" Grid.Column="1" Background="#141210" CornerRadius="8" Padding="10">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Detail" FontWeight="Bold" Foreground="#a8a29e" Margin="0,0,0,8" />
        <TextBox Text="{Binding DetailText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Classes="pos-field" />
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
