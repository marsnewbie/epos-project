<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MagicWok.Epos.ViewModels"
             xmlns:domain="using:MagicWok.Epos.Domain"
             x:Class="MagicWok.Epos.Views.OnlineView"
             x:DataType="vm:OnlineViewModel"
             Background="#1c1917">
  <DockPanel Margin="4">
    <Border DockPanel.Dock="Top" Background="#141210" CornerRadius="8" Padding="10" Margin="0,0,0,8"
            IsVisible="{Binding SetupNeeded}">
      <StackPanel Spacing="6">
        <TextBlock Text="Setup needed / 需配置" FontSize="16" FontWeight="Bold" Foreground="#fb923c" />
        <TextBlock Text="{Binding SetupHint}" TextWrapping="Wrap" Foreground="#e7e5e4" LineHeight="20" />
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Top" Background="#141210" CornerRadius="8" Padding="14" Margin="0,0,0,8">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Button Classes="pos-action pos-cash" Content="ONLINE ON / OFF"
                Command="{Binding ToggleAcceptingCommand}" Width="240" Height="72" FontSize="18" FontWeight="Bold" />
        <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center" Spacing="4">
          <TextBlock Text="{Binding PollingEnabled, StringFormat=Accepting: {0}}" FontSize="16" FontWeight="Bold"
                     Foreground="#86efac" />
          <TextBlock Text="{Binding PollerStatus}" Foreground="#fdba74" FontWeight="SemiBold" TextWrapping="Wrap" />
        </StackPanel>
        <Button Grid.Column="2" Classes="pos-nav" Content="Advanced" Command="{Binding ToggleAdvancedCommand}"
                Width="120" Height="44" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Border DockPanel.Dock="Top" Background="#0c0a09" CornerRadius="8" Padding="10" Margin="0,0,0,8"
            IsVisible="{Binding ShowAdvanced}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Classes="pos-nav" Content="Poll once" Command="{Binding PollOnceCommand}" Width="120" Height="40" />
        <Button Classes="pos-nav" Content="Test connection" Command="{Binding TestConnectionCommand}" Width="140" Height="40" />
        <Button Classes="pos-nav" Content="Reprint kitchen" Command="{Binding ReprintKitchenCommand}" Width="140" Height="40" />
        <Button Classes="pos-nav" Content="Ack printed" Command="{Binding AckAgainCommand}" Width="120" Height="40" />
      </StackPanel>
    </Border>

    <Grid ColumnDefinitions="1.1*,*">
      <Border Grid.Column="0" Background="#141210" CornerRadius="8" Padding="10" Margin="0,0,8,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Online orders / 线上单" FontSize="18" FontWeight="Bold"
                     Foreground="#fafaf9" Margin="0,0,0,8" />
          <ListBox Classes="pos-ticket" ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="domain:PosOrder">
                <Grid ColumnDefinitions="*,Auto" Margin="10,8">
                  <StackPanel>
                    <TextBlock FontWeight="Bold" FontSize="15" Foreground="#fafaf9" Text="{Binding OrderNumber}" />
                    <TextBlock Foreground="#a8a29e" FontSize="12" Text="{Binding CustomerName}" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" FontSize="18" FontWeight="Bold" Foreground="#fafaf9"
                             Text="{Binding Total, StringFormat={}£{0:0.00}}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      <Border Grid.Column="1" Background="#141210" CornerRadius="8" Padding="10">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Detail" FontWeight="Bold" Foreground="#a8a29e" Margin="0,0,0,8" />
          <TextBox Text="{Binding DetailText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Classes="pos-field" />
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
