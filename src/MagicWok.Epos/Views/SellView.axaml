<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MagicWok.Epos.ViewModels"
             xmlns:domain="using:MagicWok.Epos.Domain"
             xmlns:conv="using:MagicWok.Epos.Converters"
             x:Class="MagicWok.Epos.Views.SellView"
             x:Name="Root"
             x:DataType="vm:SellViewModel"
             Background="#1c1917">

  <Grid ColumnDefinitions="148,*,400">

    <Border Grid.Column="0" Background="#141210" CornerRadius="8" Padding="8" Margin="0,0,8,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
          <TextBox Classes="pos-field" Watermark="Search name"
                   Text="{Binding SearchText}" />
          <Grid ColumnDefinitions="*,56">
            <TextBox Classes="pos-field" Watermark="# dish no." Text="{Binding DishNumberText}" Margin="0,0,4,0" />
            <Button Grid.Column="1" Classes="pos-key" Content="+" Command="{Binding AddByDishNumberCommand}" Height="40" />
          </Grid>
          <Button Classes="pos-nav" Content="{Binding LblPhoneOrder}"
                  Command="{Binding StartPhoneOrderCommand}" Height="40" />
        </StackPanel>
        <Button DockPanel.Dock="Bottom" Classes="pos-nav" Content="Ad-hoc / 临点"
                Command="{Binding ToggleAdHocCommand}" Height="48" Margin="0,8,0,0" />
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding CategoryTiles}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:CategoryTile">
                <Button Classes="pos-cat" Classes.active="{Binding IsSelected}"
                        Content="{Binding Name}"
                        Command="{Binding DataContext.SelectCategoryCommand, ElementName=Root}"
                        CommandParameter="{Binding Category}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1" Margin="0,0,8,0">
      <DockPanel>
        <Border DockPanel.Dock="Top" Padding="4,0,4,8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding CategoryHeading}" FontSize="18" FontWeight="Bold" Foreground="#fafaf9" />
            <TextBlock Grid.Column="1" Text="{Binding PanelStatus}" Foreground="#fdba74" FontSize="12"
                       VerticalAlignment="Center" MaxWidth="300" TextTrimming="CharacterEllipsis" />
          </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#141210" CornerRadius="8" Padding="8" Margin="0,8,0,0"
                IsVisible="{Binding ShowAdHoc}">
          <Grid ColumnDefinitions="*,80,80,72">
            <TextBox Classes="pos-field" Watermark="Ad-hoc name" Text="{Binding AdHocName}" Margin="0,0,6,0" />
            <TextBox Grid.Column="1" Classes="pos-field" Watermark="£" Text="{Binding AdHocPrice}" Margin="0,0,6,0" />
            <TextBox Grid.Column="2" Classes="pos-field" Watermark="中文" Text="{Binding AdHocZh}" Margin="0,0,6,0" />
            <Button Grid.Column="3" Classes="pos-action pos-send" Content="Add" Command="{Binding AddAdHocCommand}" Height="40" />
          </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#141210" CornerRadius="8" Padding="8" Margin="0,8,0,0">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="Quick notes → last line / 快捷备注" Foreground="#a8a29e" Margin="0,0,0,6" FontSize="12" />
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Height="88">
              <ItemsControl ItemsSource="{Binding QuickNotes}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:QuickNoteItem">
                    <Button Classes="pos-chip" Content="{Binding Display}"
                            Command="{Binding DataContext.ApplyQuickNoteCommand, ElementName=Root}"
                            CommandParameter="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="domain:MenuItem">
                <Button Classes="pos-dish"
                        Command="{Binding DataContext.SelectItemCommand, ElementName=Root}"
                        CommandParameter="{Binding}">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding MenuNumber}" FontSize="16" FontWeight="Bold" Foreground="#c2410c" />
                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold" MaxHeight="36" />
                    <TextBlock Text="{Binding BasePrice, StringFormat={}£{0:0.00}}" FontSize="12" Foreground="#57534e" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>

      <Border IsVisible="{Binding ShowModifierPanel}" Background="#CC0c0a09" CornerRadius="8" ZIndex="10">
        <Border Background="#1c1917" BorderBrush="#c2410c" BorderThickness="2" CornerRadius="10"
                Margin="24" Padding="16" MaxWidth="640" HorizontalAlignment="Center" VerticalAlignment="Center">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding ModifierTitle}" FontSize="20" FontWeight="Bold"
                       Foreground="#fafaf9" Margin="0,0,0,8" TextWrapping="Wrap" />
            <TextBlock DockPanel.Dock="Top" Text="{Binding ModifierSummary}" Foreground="#fdba74"
                       TextWrapping="Wrap" Margin="0,0,0,12" />
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
              <Button Classes="pos-action pos-send" Content="ADD TO TICKET / 加入" Command="{Binding AddSelectedItemCommand}" Width="220" />
              <Button Classes="pos-action pos-danger" Content="Cancel" Command="{Binding CancelModifierCommand}" Width="120" />
            </StackPanel>
            <TextBox DockPanel.Dock="Bottom" Classes="pos-field" Watermark="Line note / 备注"
                     Text="{Binding LineNotesDraft}" Margin="0,8,0,0" />
            <ScrollViewer MaxHeight="280">
              <ItemsControl ItemsSource="{Binding OptionChips}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:OptionChoiceChip">
                    <Button Classes="pos-chip-opt" Classes.active="{Binding IsSelected}" Content="{Binding Label}"
                            Command="{Binding DataContext.ToggleOptionCommand, ElementName=Root}"
                            CommandParameter="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Border>
    </Grid>

    <Border Grid.Column="2" Background="#141210" CornerRadius="8" Padding="10">
      <DockPanel>
        <Border DockPanel.Dock="Top" Background="#0c0a09" CornerRadius="6" Padding="8,6" Margin="0,0,0,8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding TicketHeader}" FontSize="15" FontWeight="Bold" Foreground="#fafaf9"
                       VerticalAlignment="Center" />
            <Border Grid.Column="1" Background="#c2410c" CornerRadius="4" Padding="8,2"
                    IsVisible="{Binding TicketIsSent}">
              <TextBlock Text="{Binding TicketStatusBadge}" FontWeight="Bold" FontSize="11" Foreground="#fff7ed" />
            </Border>
          </Grid>
        </Border>

        <UniformGrid DockPanel.Dock="Top" Columns="4" Margin="0,0,0,8">
          <Button Classes="pos-type" Classes.active="{Binding IsCollection}" Content="COL&#x0a;自取"
                  Command="{Binding SetOrderTypeCommand}" CommandParameter="Collection" Margin="0,0,4,0" />
          <Button Classes="pos-type" Classes.active="{Binding IsDelivery}" Content="DEL&#x0a;外卖"
                  Command="{Binding SetOrderTypeCommand}" CommandParameter="Delivery" Margin="0,0,4,0" />
          <Button Classes="pos-type" Classes.active="{Binding IsWalkIn}" Content="WAIT&#x0a;堂等"
                  Command="{Binding SetOrderTypeCommand}" CommandParameter="WalkIn" Margin="0,0,4,0" />
          <Button Classes="pos-type" Classes.active="{Binding IsEatIn}" Content="TABLE&#x0a;堂食"
                  Command="{Binding SetOrderTypeCommand}" CommandParameter="EatIn" />
        </UniformGrid>

        <StackPanel DockPanel.Dock="Top">
          <TextBox Classes="pos-field" Watermark="Name / 姓名" Text="{Binding CustomerName}" />
          <TextBox Classes="pos-field" Watermark="Phone / 电话" Text="{Binding CustomerPhone}" />
          <TextBox Classes="pos-field" Watermark="Address / 地址" Text="{Binding DeliveryAddress}"
                   IsVisible="{Binding IsDelivery}" />
          <TextBox Classes="pos-field" Watermark="Postcode" Text="{Binding DeliveryPostcode}"
                   IsVisible="{Binding IsDelivery}" />
          <TextBox Classes="pos-field" Watermark="Table / pager #" Text="{Binding TableNumber}"
                   IsVisible="{Binding IsEatIn}" />
          <TextBox Classes="pos-field" Watermark="Order notes / 整单备注" Text="{Binding OrderNotes}" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding LineCount, StringFormat={}{0} items}" Foreground="#a8a29e" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding Total, StringFormat={}£{0:0.00}}"
                       FontSize="28" FontWeight="Bold" Foreground="#fafaf9" />
          </Grid>
          <Grid ColumnDefinitions="*,*">
            <TextBlock Text="{Binding Subtotal, StringFormat=Sub £{0:0.00}}" Foreground="#a8a29e" FontSize="12" />
            <TextBlock Grid.Column="1" Text="{Binding DeliveryFee, StringFormat=Del £{0:0.00}}"
                       Foreground="#a8a29e" FontSize="12" HorizontalAlignment="Right"
                       IsVisible="{Binding IsDelivery}" />
          </Grid>

          <Grid ColumnDefinitions="*,*,*" IsEnabled="{Binding CanEditSelectedLine}">
            <Button Grid.Column="0" Classes="pos-key" Content="−" Command="{Binding QtyMinusCommand}" Margin="0,0,4,0" />
            <Button Grid.Column="1" Classes="pos-key" Content="+" Command="{Binding QtyPlusCommand}" Margin="0,0,4,0" />
            <Button Grid.Column="2" Classes="pos-key" Content="⌫" Command="{Binding RemoveLineCommand}" />
          </Grid>

          <Border Background="#0c0a09" CornerRadius="6" Padding="6">
            <StackPanel>
              <Grid ColumnDefinitions="*,Auto" Margin="2,0,2,4">
                <TextBlock Text="{Binding CashTenderedText, StringFormat=Cash £{0}}" FontSize="16"
                           FontWeight="Bold" Foreground="#86efac" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding ChangeText}" Foreground="#fde68a" FontWeight="SemiBold" />
              </Grid>
              <UniformGrid Columns="4">
                <Button Classes="pos-key" Content="1" Command="{Binding CashDigitCommand}" CommandParameter="1" />
                <Button Classes="pos-key" Content="2" Command="{Binding CashDigitCommand}" CommandParameter="2" />
                <Button Classes="pos-key" Content="3" Command="{Binding CashDigitCommand}" CommandParameter="3" />
                <Button Classes="pos-key" Content="£10" Command="{Binding CashQuickCommand}" CommandParameter="10" />
                <Button Classes="pos-key" Content="4" Command="{Binding CashDigitCommand}" CommandParameter="4" />
                <Button Classes="pos-key" Content="5" Command="{Binding CashDigitCommand}" CommandParameter="5" />
                <Button Classes="pos-key" Content="6" Command="{Binding CashDigitCommand}" CommandParameter="6" />
                <Button Classes="pos-key" Content="£20" Command="{Binding CashQuickCommand}" CommandParameter="20" />
                <Button Classes="pos-key" Content="7" Command="{Binding CashDigitCommand}" CommandParameter="7" />
                <Button Classes="pos-key" Content="8" Command="{Binding CashDigitCommand}" CommandParameter="8" />
                <Button Classes="pos-key" Content="9" Command="{Binding CashDigitCommand}" CommandParameter="9" />
                <Button Classes="pos-key" Content="Exact" Command="{Binding CashExactCommand}" />
                <Button Classes="pos-key" Content="C" Command="{Binding CashClearCommand}" />
                <Button Classes="pos-key" Content="0" Command="{Binding CashDigitCommand}" CommandParameter="0" />
                <Button Classes="pos-key" Content="." Command="{Binding CashDigitCommand}" CommandParameter="." />
                <Button Classes="pos-key" Content="£50" Command="{Binding CashQuickCommand}" CommandParameter="50" />
              </UniformGrid>
            </StackPanel>
          </Border>

          <Button Classes="pos-action pos-send" Content="{Binding SendButtonText}" Command="{Binding SendKitchenCommand}" Height="52" />
          <Grid ColumnDefinitions="*,*">
            <Button Grid.Column="0" Classes="pos-action pos-card" Content="{Binding LblHold}"
                    Command="{Binding HoldTicketCommand}" Margin="0,0,4,0" Height="48" />
            <Button Grid.Column="1" Classes="pos-nav" Content="{Binding LblNew}"
                    Command="{Binding NewTicketCommand}" Height="48" />
          </Grid>
          <Grid ColumnDefinitions="*,*">
            <Button Grid.Column="0" Classes="pos-action pos-cash" Content="{Binding LblPayCash}"
                    Command="{Binding PayCashCommand}" Margin="0,0,4,0" Height="52" />
            <Button Grid.Column="1" Classes="pos-action pos-card" Content="{Binding LblPayCard}"
                    Command="{Binding PayCardCommand}" Height="52" />
          </Grid>
          <Button Classes="pos-nav" Content="{Binding LblClear}" Command="{Binding ClearTicketCommand}" Height="36" />

          <ItemsControl ItemsSource="{Binding HeldOrders}" MaxHeight="72">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="domain:PosOrder">
                <Button Classes="pos-chip" Margin="0,2"
                        Command="{Binding DataContext.ResumeHeldCommand, ElementName=Root}"
                        CommandParameter="{Binding}">
                  <TextBlock>
                    <Run Text="{Binding HoldLabel}" />
                    <Run Text=" · " />
                    <Run Text="{Binding OrderNumber}" />
                  </TextBlock>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <ListBox Classes="pos-ticket" ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}" Margin="0,8">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="domain:CartLine">
              <Grid ColumnDefinitions="36,*,48,64" Margin="8,6" Opacity="{Binding KitchenSent, Converter={x:Static conv:BoolToOpacityConverter.Instance}}">
                <TextBlock Text="{Binding Quantity, StringFormat={}{0}×}" FontWeight="Bold" Foreground="#fb923c"
                           FontSize="15" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" Margin="4,0">
                  <TextBlock Text="{Binding Name}" TextWrapping="Wrap" Foreground="#fafaf9" FontWeight="SemiBold" FontSize="13" />
                  <TextBlock Text="{Binding ItemTranslation}" Foreground="#a8a29e" FontSize="11" />
                  <TextBlock Text="{Binding OptionsSummary}" TextWrapping="Wrap" Foreground="#78716c" FontSize="11" />
                </StackPanel>
                <Border Grid.Column="2" Background="#44403c" CornerRadius="3" Padding="4,2" VerticalAlignment="Top"
                        HorizontalAlignment="Center" Margin="2,0">
                  <TextBlock Text="{Binding SentBadge}" FontSize="9" FontWeight="Bold" Foreground="#fdba74" />
                </Border>
                <TextBlock Grid.Column="3" Text="{Binding LineTotal, StringFormat={}£{0:0.00}}"
                           FontWeight="Bold" Foreground="#fafaf9" HorizontalAlignment="Right" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
