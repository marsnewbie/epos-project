<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MagicWok.Epos.App"
             xmlns:local="using:MagicWok.Epos"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://MagicWok.Epos/Styles/PosTheme.axaml" />
    </Application.Styles>
</Application>
